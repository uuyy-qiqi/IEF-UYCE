<Window x:Class="PclLike.Gui.TextInputDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:shell="clr-namespace:System.Windows.Shell;assembly=PresentationFramework"
        Width="400" SizeToContent="Height"
        WindowStartupLocation="CenterOwner"
        WindowStyle="None" AllowsTransparency="True" Background="Transparent"
        FontFamily="Microsoft YaHei UI, Segoe UI" FontSize="12.5"
        Foreground="{StaticResource TextBrush}">
    <!--
        照 PCL 那个「输入实例名称」做的：蓝顶栏 + 一行说明 + 一个输入框 + 确定/取消。
        单独抽成一个类，因为新建实例、重命名、复制、加文件夹都要用它 ——
        写一份，四处调用（PCL 上也是同一个弹窗）。
    -->
    <Window.Resources>
        <!--
            顶栏按钮样式必须 TargetType="Button" —— 共用字典里的 TopBarButton
            是给左侧导航的 RadioButton 用的，套到 Button 上会在 Show() 时抛
            XamlParseException（"RadioButton" TargetType 与元素"Button"不匹配），
            窗口直接崩。任务管理窗踩过一次，这里是第二处。
        -->
        <Style x:Key="DlgTopButton" TargetType="Button">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Width" Value="42"/>
            <Setter Property="Height" Value="32"/>
            <Setter Property="FontFamily" Value="Segoe MDL2 Assets"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Bg" Background="{TemplateBinding Background}"
                                CornerRadius="3">
                            <ContentPresenter HorizontalAlignment="Center"
                                              VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bg" Property="Background" Value="#33FFFFFF"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <shell:WindowChrome.WindowChrome>
        <shell:WindowChrome CaptionHeight="0" ResizeBorderThickness="0"
                            GlassFrameThickness="0" CornerRadius="0"
                            UseAeroCaptionButtons="False"/>
    </shell:WindowChrome.WindowChrome>

    <Border Background="{StaticResource CardBrush}"
            BorderBrush="#2B4A7E" BorderThickness="1" CornerRadius="6">
        <StackPanel>
            <!-- 蓝顶栏：标题 + 关闭 -->
            <Border Background="{StaticResource TopBarBrush}" CornerRadius="5,5,0,0"
                    MouseLeftButtonDown="TopBar_MouseDown">
                <Grid Height="40">
                    <TextBlock x:Name="TitleText" Margin="14,0,0,0" VerticalAlignment="Center"
                               FontSize="13.5" Foreground="White"/>
                    <Button HorizontalAlignment="Right" Click="Cancel_Click"
                            Style="{StaticResource DlgTopButton}" Content="&#xE8BB;"
                            FontFamily="Segoe MDL2 Assets" FontSize="11" ToolTip="取消"/>
                </Grid>
            </Border>

            <!-- 说明 + 输入框 -->
            <StackPanel Margin="18,16,18,0">
                <TextBlock x:Name="HintText" Foreground="{StaticResource TextMutedBrush}"
                           TextWrapping="Wrap"/>
                <TextBox x:Name="Input" Margin="0,10,0,0" Padding="8,6"
                         Background="{StaticResource SurfaceBrush}"
                         BorderBrush="{StaticResource BorderBrush2}" BorderThickness="1"
                         Foreground="{StaticResource TextBrush}" FontSize="13"
                         KeyDown="Input_KeyDown"/>
            </StackPanel>

            <!-- 确定 / 取消 -->
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right"
                        Margin="18,16,18,16">
                <Button x:Name="OkButton" Content="确定" Click="Ok_Click"
                        Style="{StaticResource PrimaryButton}" Padding="22,7" Margin="0,0,8,0"/>
                <Button Content="取消" Click="Cancel_Click"
                        Style="{StaticResource FlatButton}" Padding="22,7" IsCancel="True"/>
            </StackPanel>
        </StackPanel>
    </Border>
</Window>