<Window x:Class="PclLike.Gui.LoginWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:wv2="clr-namespace:Microsoft.Web.WebView2.Wpf;assembly=Microsoft.Web.WebView2.Wpf"
        Title="登录 Microsoft 账号" Width="740" Height="660"
        Icon="Assets/pclike.png"
        WindowStartupLocation="CenterOwner"
        Background="{StaticResource BgBrush}" FontFamily="Microsoft YaHei UI">
  <Grid>
    <Grid.RowDefinitions>
      <RowDefinition Height="Auto"/>
      <RowDefinition Height="*"/>
      <RowDefinition Height="Auto"/>
    </Grid.RowDefinitions>

    <Border Grid.Row="0" Background="{StaticResource SurfaceBrush}" Padding="16,8">
      <Grid>
        <Grid.ColumnDefinitions>
          <ColumnDefinition Width="*"/>
          <ColumnDefinition Width="Auto"/>
        </Grid.ColumnDefinitions>

        <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
          <TextBlock Text="在下面登录你的 Microsoft 账号" FontSize="13" FontWeight="SemiBold"
                     Foreground="{StaticResource FgBrush}" VerticalAlignment="Center"/>
          <TextBlock Text="登录成功后这个窗口会自己关上。" FontSize="11"
                     Foreground="{StaticResource MutedBrush}" Margin="12,0,0,0"
                     VerticalAlignment="Center"/>
        </StackPanel>

        <!-- 登错账号时唯一的出路：内嵌浏览器自己记着微软的登录状态，
             直接再点一次登录会闷头进同一个账号，不会给你选账号的机会。
             这个按钮先去微软那边登出，再回到登录页。 -->
        <Button Grid.Column="1" x:Name="SwitchAccountButton" Content="换个微软账号"
                Style="{StaticResource FlatButton}" Height="30" Padding="14,4"
                ToolTip="退出浏览器里记住的那个微软账号，回到登录页重新选"
                Click="SwitchAccount_Click"/>
      </Grid>
    </Border>

    <!-- 登录页必须是真的渲染出来的网页：微软那套风控认不出来自 HTTP 客户端的请求，
         自己拼请求模拟登录走不通，只能让用户在真浏览器控件里输。 -->
    <wv2:WebView2 Grid.Row="1" x:Name="Browser"/>

    <Border Grid.Row="2" Background="{StaticResource SurfaceBrush}" Padding="16,10">
      <Grid>
        <TextBlock x:Name="StatusText" Text="正在打开登录页面…" FontSize="11"
                   Foreground="{StaticResource MutedBrush}" VerticalAlignment="Center"/>
        <Button Content="取消" Style="{StaticResource FlatButton}" Height="30" Padding="14,4"
                HorizontalAlignment="Right" Click="Cancel_Click"/>
      </Grid>
    </Border>
  </Grid>
</Window>