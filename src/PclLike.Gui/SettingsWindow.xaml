<Window x:Class="PclLike.Gui.SettingsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="设置" Height="560" Width="620"
        Icon="Assets/pclike.png"
        Background="{StaticResource BgBrush}"
        WindowStartupLocation="CenterOwner"
        ResizeMode="CanResize"
        UseLayoutRounding="True" SnapsToDevicePixels="True">

  <Grid Margin="20">
    <Grid.RowDefinitions>
      <RowDefinition Height="*"/>
      <RowDefinition Height="Auto"/>
    </Grid.RowDefinitions>

    <ScrollViewer Grid.Row="0" VerticalScrollBarVisibility="Auto">
      <StackPanel Margin="0,0,10,0">

        <TextBlock Text="账号" FontSize="15" FontWeight="Bold"
                   Foreground="{StaticResource AccentHiBrush}" Margin="0,0,0,10"/>

        <TextBlock Text="玩家名" FontSize="12" Foreground="{StaticResource MutedBrush}"/>
        <TextBox x:Name="UsernameBox" Margin="0,5,0,4" MaxLength="16"/>
        <TextBlock Text="离线模式用。3~16 位，只能是字母、数字、下划线。"
                   FontSize="11" Foreground="#6A6A78" Margin="0,0,0,16"/>

        <Separator Background="{StaticResource BorderBrush2}" Margin="0,0,0,16"/>

        <TextBlock Text="Java" FontSize="15" FontWeight="Bold"
                   Foreground="{StaticResource AccentHiBrush}" Margin="0,0,0,10"/>

        <TextBlock Text="手动指定 java.exe（留空 = 自动探测）" FontSize="12"
                   Foreground="{StaticResource MutedBrush}"/>
        <Grid Margin="0,5,0,6">
          <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*"/>
            <ColumnDefinition Width="Auto"/>
          </Grid.ColumnDefinitions>
          <TextBox Grid.Column="0" x:Name="JavaPathBox"/>
          <Button Grid.Column="1" Content="浏览…" Style="{StaticResource FlatButton}"
                  Margin="8,0,0,0" Click="BrowseJava_Click"/>
        </Grid>

        <ItemsControl x:Name="JavaListBox" Margin="0,4,0,16">
          <ItemsControl.ItemTemplate>
            <DataTemplate>
              <TextBlock FontSize="11.5" Foreground="{StaticResource MutedBrush}"
                         Margin="0,1,0,0" TextTrimming="CharacterEllipsis">
                <Run Text="· Java "/>
                <Run Text="{Binding MajorVersion, Mode=OneWay}"/>
                <Run Text=" — "/>
                <Run Text="{Binding Path, Mode=OneWay}"/>
              </TextBlock>
            </DataTemplate>
          </ItemsControl.ItemTemplate>
        </ItemsControl>

        <Separator Background="{StaticResource BorderBrush2}" Margin="0,0,0,16"/>

        <TextBlock Text="游戏" FontSize="15" FontWeight="Bold"
                   Foreground="{StaticResource AccentHiBrush}" Margin="0,0,0,10"/>

        <Grid>
          <TextBlock Text="最大内存" FontSize="12" Foreground="{StaticResource MutedBrush}"/>
          <TextBlock x:Name="MemoryText" FontSize="12"
                     Foreground="{StaticResource AccentHiBrush}" HorizontalAlignment="Right"/>
        </Grid>
        <Slider x:Name="MemorySlider" Minimum="1024" Maximum="32768" TickFrequency="512"
                IsSnapToTickEnabled="True" Margin="0,5,0,14"/>

        <TextBlock Text="启动后自动连接服务器（host 或 host:port，留空 = 不连）" FontSize="12"
                   Foreground="{StaticResource MutedBrush}"/>
        <TextBox x:Name="ServerBox" Margin="0,5,0,14"/>

        <TextBlock Text="额外 JVM 参数（一行一个）" FontSize="12"
                   Foreground="{StaticResource MutedBrush}"/>
        <TextBox x:Name="JvmArgsBox" Margin="0,5,0,14" Height="74"
                 AcceptsReturn="True" TextWrapping="NoWrap" VerticalScrollBarVisibility="Auto"
                 FontFamily="Consolas, Cascadia Mono, monospace"/>

        <CheckBox x:Name="AutoInstallCheck" Content="启动前自动补全缺失文件"
                  Foreground="{StaticResource FgBrush}" FontSize="12.5" Margin="0,2,0,8"/>
        <CheckBox x:Name="KillOnExitCheck" Content="关闭启动器时一并结束游戏进程"
                  Foreground="{StaticResource FgBrush}" FontSize="12.5" Margin="0,0,0,4"/>

      </StackPanel>
    </ScrollViewer>

    <StackPanel Grid.Row="1" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,16,0,0">
      <Button Content="取消" Style="{StaticResource FlatButton}" Width="90"
              Click="Cancel_Click" Margin="0,0,8,0"/>
      <Button Content="保存" Style="{StaticResource PrimaryButton}" Width="110"
              Padding="0,8" Click="Save_Click"/>
    </StackPanel>
  </Grid>
</Window>