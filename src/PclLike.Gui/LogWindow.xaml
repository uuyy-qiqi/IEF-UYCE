<Window x:Class="PclLike.Gui.LogWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:local="clr-namespace:PclLike.Gui"
        Title="启动器日志" Width="880" Height="560"
        WindowStyle="None" AllowsTransparency="True" Background="Transparent"
        WindowStartupLocation="CenterOwner" ShowInTaskbar="False"
        FontFamily="Microsoft YaHei UI"
        TextOptions.TextFormattingMode="Display"
        UseLayoutRounding="True">

  <WindowChrome.WindowChrome>
    <WindowChrome CaptionHeight="0" ResizeBorderThickness="6"
                  GlassFrameThickness="0" CornerRadius="0"
                  UseAeroCaptionButtons="False"/>
  </WindowChrome.WindowChrome>

  <Border Background="{StaticResource BgBrush}" BorderBrush="{StaticResource BorderBrush2}"
          BorderThickness="1">
    <Grid>
      <Grid.RowDefinitions>
        <RowDefinition Height="Auto"/>
        <RowDefinition Height="*"/>
        <RowDefinition Height="Auto"/>
      </Grid.RowDefinitions>

      <!-- ════ 顶栏 ════ -->
      <Border Grid.Row="0" Background="{StaticResource TopBarBrush}" Height="44"
              MouseLeftButtonDown="TopBar_MouseDown">
        <Grid Margin="14,0,6,0">
          <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*"/>
            <ColumnDefinition Width="Auto"/>
          </Grid.ColumnDefinitions>

          <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
            <TextBlock Text="&#xE9D9;" FontFamily="Segoe MDL2 Assets" FontSize="13"
                       Foreground="White" VerticalAlignment="Center" Margin="0,0,8,0"/>
            <TextBlock Text="启动器日志" FontSize="14" FontWeight="SemiBold"
                       Foreground="White" VerticalAlignment="Center"/>
            <TextBlock x:Name="CountText" Text="" FontSize="11.5"
                       Foreground="#C8DCFF" VerticalAlignment="Center" Margin="10,0,0,0"/>
          </StackPanel>

          <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
            <Button Click="Minimize_Click" Cursor="Hand" Background="Transparent"
                    BorderThickness="0" Width="34" Height="34" ToolTip="最小化">
              <Button.Template>
                <ControlTemplate TargetType="Button">
                  <Border x:Name="Bd" Background="Transparent">
                    <TextBlock Text="&#xE921;" FontFamily="Segoe MDL2 Assets" FontSize="11"
                               Foreground="White" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                  </Border>
                  <ControlTemplate.Triggers>
                    <Trigger Property="IsMouseOver" Value="True">
                      <Setter TargetName="Bd" Property="Background" Value="#30FFFFFF"/>
                    </Trigger>
                  </ControlTemplate.Triggers>
                </ControlTemplate>
              </Button.Template>
            </Button>

            <Button Click="Close_Click" Cursor="Hand" Background="Transparent"
                    BorderThickness="0" Width="34" Height="34" ToolTip="关闭">
              <Button.Template>
                <ControlTemplate TargetType="Button">
                  <Border x:Name="Bd" Background="Transparent">
                    <TextBlock Text="&#xE8BB;" FontFamily="Segoe MDL2 Assets" FontSize="11"
                               Foreground="White" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                  </Border>
                  <ControlTemplate.Triggers>
                    <Trigger Property="IsMouseOver" Value="True">
                      <Setter TargetName="Bd" Property="Background" Value="#30FFFFFF"/>
                    </Trigger>
                  </ControlTemplate.Triggers>
                </ControlTemplate>
              </Button.Template>
            </Button>
          </StackPanel>
        </Grid>
      </Border>

      <!-- ════ 日志本体 ════ -->
      <Border Grid.Row="1" Margin="10" Background="{StaticResource CardBrush}"
              BorderBrush="{StaticResource BorderBrush2}" BorderThickness="1" CornerRadius="6">
        <ListBox x:Name="LogList" ItemsSource="{Binding LogLines}"
                 Background="Transparent" BorderThickness="0" Padding="0,6"
                 ScrollViewer.HorizontalScrollBarVisibility="Auto"
                 VirtualizingPanel.IsVirtualizing="True"
                 VirtualizingPanel.VirtualizationMode="Recycling">
          <ListBox.ItemContainerStyle>
            <Style TargetType="ListBoxItem">
              <Setter Property="Padding" Value="0"/>
              <Setter Property="Template">
                <Setter.Value>
                  <ControlTemplate TargetType="ListBoxItem">
                    <ContentPresenter/>
                  </ControlTemplate>
                </Setter.Value>
              </Setter>
            </Style>
          </ListBox.ItemContainerStyle>
          <ListBox.ItemTemplate>
            <DataTemplate DataType="{x:Type local:LogLine}">
              <StackPanel Orientation="Horizontal" Margin="12,1,12,1">
                <TextBlock Text="{Binding Timestamp}" FontSize="11.5"
                           FontFamily="{StaticResource MonoFont}"
                           Foreground="{StaticResource TextMutedBrush}" Margin="0,0,8,0"/>
                <TextBlock Text="{Binding Text}" FontSize="11.5"
                           FontFamily="{StaticResource MonoFont}"
                           Foreground="{Binding Brush}"/>
              </StackPanel>
            </DataTemplate>
          </ListBox.ItemTemplate>
        </ListBox>
      </Border>

      <!-- ════ 底栏 ════ -->
      <Border Grid.Row="2" Padding="10,0,10,10">
        <Grid>
          <Grid.ColumnDefinitions>
            <ColumnDefinition Width="Auto"/>
            <ColumnDefinition Width="*"/>
            <ColumnDefinition Width="Auto"/>
          </Grid.ColumnDefinitions>

          <CheckBox x:Name="FollowBox" Grid.Column="0" Content="自动滚到最新"
                    IsChecked="True" VerticalAlignment="Center" FontSize="12.5"
                    Foreground="{StaticResource TextSoftBrush}"/>

          <TextBlock Grid.Column="1" Text="日志只记录启动器自己的动作，游戏自己的输出在 游戏目录\logs\latest.log 里。"
                     FontSize="11.5" Foreground="{StaticResource TextMutedBrush}"
                     VerticalAlignment="Center" Margin="16,0" TextTrimming="CharacterEllipsis"/>

          <StackPanel Grid.Column="2" Orientation="Horizontal">
            <Button Content="复制全部" Style="{StaticResource FlatButton}"
                    Click="CopyAll_Click" Margin="0,0,8,0"/>
            <Button Content="清空" Style="{StaticResource FlatButton}"
                    Click="Clear_Click" Margin="0,0,8,0"/>
            <Button Content="关闭" Style="{StaticResource PrimaryButton}"
                    Click="Close_Click"/>
          </StackPanel>
        </Grid>
      </Border>
    </Grid>
  </Border>
</Window>