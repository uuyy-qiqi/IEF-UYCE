<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:local="clr-namespace:PclLike.Gui"
                    xmlns:sys="clr-namespace:System;assembly=System.Runtime">

  <!-- ════════════════════════════════════════════════════════════
       配色 —— 对照 PCL2 CE 的浅蓝主题。 背景：极浅蓝灰，大面积留白用的
         卡片        纯白，浮在背景上
         主色        亮蓝，用在顶栏、选中态、主按钮
         描边        很淡的蓝灰，只用来分隔       ════════════════════════════════════════════════════════════ -->

  <!-- 底色带 alpha 是故意的：窗口后面由 DWM 画一层亚克力模糊
       （见 WindowBackdrop.cs），留出透明度那层模糊才看得见。
       透明度不能给太狠 —— 字要始终压得住背景，所以窗口底 40%、卡片 76%，
       越"上层"的东西越不透明，文字永远不会糊。 -->
  <Color x:Key="BgColor">#66F0F4FA</Color>
  <Color x:Key="CardColor">#C2FFFFFF</Color>
  <Color x:Key="PrimaryColor">#1A6FD4</Color>
  <Color x:Key="PrimaryHiColor">#4A9BE8</Color>
  <Color x:Key="PrimaryLoColor">#14589F</Color>
  <Color x:Key="BorderColor">#E2E8F2</Color>
  <Color x:Key="TextColor">#1E2430</Color>
  <Color x:Key="TextSoftColor">#5A6478</Color>
  <Color x:Key="TextMutedColor">#98A2B6</Color>
  <Color x:Key="HoverColor">#EAF1FB</Color>
  <Color x:Key="SelectedColor">#DCE9FA</Color>
  <Color x:Key="DangerColor">#D9534F</Color>
  <Color x:Key="SuccessColor">#3FA45B</Color>
  <Color x:Key="WarnColor">#E0A030</Color>

  <SolidColorBrush x:Key="BgBrush" Color="{StaticResource BgColor}"/>
  <SolidColorBrush x:Key="CardBrush" Color="{StaticResource CardColor}"/>
  <SolidColorBrush x:Key="PrimaryBrush" Color="{StaticResource PrimaryColor}"/>
  <SolidColorBrush x:Key="PrimaryHiBrush" Color="{StaticResource PrimaryHiColor}"/>
  <SolidColorBrush x:Key="PrimaryLoBrush" Color="{StaticResource PrimaryLoColor}"/>
  <SolidColorBrush x:Key="BorderBrush2" Color="{StaticResource BorderColor}"/>
  <SolidColorBrush x:Key="TextBrush" Color="{StaticResource TextColor}"/>
  <SolidColorBrush x:Key="TextSoftBrush" Color="{StaticResource TextSoftColor}"/>
  <SolidColorBrush x:Key="TextMutedBrush" Color="{StaticResource TextMutedColor}"/>
  <SolidColorBrush x:Key="HoverBrush" Color="{StaticResource HoverColor}"/>
  <SolidColorBrush x:Key="SelectedBrush" Color="{StaticResource SelectedColor}"/>
  <SolidColorBrush x:Key="DangerBrush" Color="{StaticResource DangerColor}"/>
  <SolidColorBrush x:Key="SuccessBrush" Color="{StaticResource SuccessColor}"/>
  <SolidColorBrush x:Key="WarnBrush" Color="{StaticResource WarnColor}"/>

  <!-- 左栏：比卡片更透一点，让侧栏和内容区在毛玻璃上能分得出来 -->
  <Color x:Key="RailColor">#47FFFFFF</Color>
  <SolidColorBrush x:Key="RailBrush" Color="{StaticResource RailColor}"/>

  <!-- 顶栏：主色留一点点透明，毛玻璃那层模糊能微微透上来 -->
  <Color x:Key="TopBarColor">#CC1A6FD4</Color>
  <SolidColorBrush x:Key="TopBarBrush" Color="{StaticResource TopBarColor}"/>

  <!-- 兼容旧键名，免得改一处漏一处 -->
  <SolidColorBrush x:Key="FgBrush" Color="{StaticResource TextColor}"/>
  <SolidColorBrush x:Key="MutedBrush" Color="{StaticResource TextMutedColor}"/>
  <SolidColorBrush x:Key="SurfaceBrush" Color="{StaticResource CardColor}"/>
  <SolidColorBrush x:Key="SurfaceHiBrush" Color="{StaticResource HoverColor}"/>
  <SolidColorBrush x:Key="AccentBrush" Color="{StaticResource PrimaryColor}"/>
  <SolidColorBrush x:Key="AccentHiBrush" Color="{StaticResource PrimaryHiColor}"/>
  <SolidColorBrush x:Key="OkBrush" Color="{StaticResource SuccessColor}"/>

  <!-- ════════════════ 版本列表 ════════════════ -->

  <Style x:Key="VersionList" TargetType="ListBox">
    <Setter Property="Background" Value="Transparent"/>
    <Setter Property="BorderThickness" Value="0"/>
    <Setter Property="ScrollViewer.HorizontalScrollBarVisibility" Value="Disabled"/>
    <Setter Property="ScrollViewer.VerticalScrollBarVisibility" Value="Auto"/>

    <!-- 给右边留出滚动条的宽度。不留的话滚动条会压在版本类型徽章（快照/正式版）上面，徽章被切掉一半 —— ListBox 的滚动条是叠在内容区里的，不是另外占一列。 -->
    <Setter Property="Padding" Value="0,0,10,0"/>

    <Setter Property="VirtualizingPanel.IsVirtualizing" Value="True"/>
    <Setter Property="VirtualizingPanel.VirtualizationMode" Value="Recycling"/>
  </Style>

  <Style x:Key="VersionItem" TargetType="ListBoxItem">
    <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
    <Setter Property="Padding" Value="0"/>

    <!-- 右边留出滚动条的位置。留白必须加在 item 上而不是 ListBox 上：item 的 HorizontalContentAlignment 是 Stretch，会被撑满整个视口（视口宽度包含滚动条），所以只有 item 自己的 Margin 能把右侧徽章从滚动条底下挪出来。 -->
    <Setter Property="Margin" Value="0,1,12,1"/>
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="ListBoxItem">
          <Border x:Name="Bd" Background="Transparent" CornerRadius="5"
                  Padding="11,8">
            <ContentPresenter/>
          </Border>
          <ControlTemplate.Triggers>
            <Trigger Property="IsMouseOver" Value="True">
              <Setter TargetName="Bd" Property="Background" Value="{StaticResource HoverBrush}"/>
            </Trigger>
            <Trigger Property="IsSelected" Value="True">
              <Setter TargetName="Bd" Property="Background" Value="{StaticResource SelectedBrush}"/>
            </Trigger>
          </ControlTemplate.Triggers>
        </ControlTemplate>
      </Setter.Value>
    </Setter>
  </Style>

  <!-- 兼容旧的日志框样式名 -->
  <Style x:Key="LogBox" TargetType="ListBox">
    <Setter Property="Background" Value="Transparent"/>
    <Setter Property="BorderThickness" Value="0"/>
  </Style>

  <!-- ════════════════ 字体 ════════════════ -->
  <FontFamily x:Key="UiFont">Microsoft YaHei UI, Segoe UI, sans-serif</FontFamily>
  <FontFamily x:Key="MonoFont">Consolas, Cascadia Mono, monospace</FontFamily>

  <sys:Double x:Key="FsH1">22</sys:Double>
  <sys:Double x:Key="FsH2">16</sys:Double>
  <sys:Double x:Key="FsBody">13</sys:Double>
  <sys:Double x:Key="FsSmall">12</sys:Double>
  <sys:Double x:Key="FsTiny">11</sys:Double>

  <!-- ════════════════════════════════════════════════════════════
       卡片：白底 + 1px 淡描边 + 6px 圆角，是整页的基本单元       ════════════════════════════════════════════════════════════ -->
  <Style x:Key="Card" TargetType="Border">
    <Setter Property="Background" Value="{StaticResource CardBrush}"/>
    <Setter Property="BorderBrush" Value="{StaticResource BorderBrush2}"/>
    <Setter Property="BorderThickness" Value="1"/>
    <Setter Property="CornerRadius" Value="6"/>
    <Setter Property="Margin" Value="0,0,0,12"/>
    <Setter Property="Padding" Value="16,14"/>
  </Style>

  <!-- 可点击的卡片列表项 -->
  <Style x:Key="CardRow" TargetType="Border">
    <Setter Property="Background" Value="{StaticResource CardBrush}"/>
    <Setter Property="BorderBrush" Value="{StaticResource BorderBrush2}"/>
    <Setter Property="BorderThickness" Value="1"/>
    <Setter Property="CornerRadius" Value="6"/>
    <Setter Property="Padding" Value="14,12"/>
    <Setter Property="Margin" Value="0,0,0,8"/>
  </Style>

  <!-- ════════════════════════════════════════════════════════════
       左侧导航
       ════════════════════════════════════════════════════════════ -->

  <!-- 分组标题：「游戏 / 工具 / 启动器 / 关于」 -->
  <Style x:Key="NavGroupHeader" TargetType="TextBlock">
    <Setter Property="FontSize" Value="11.5"/>
    <Setter Property="Foreground" Value="{StaticResource TextMutedBrush}"/>
    <Setter Property="FontFamily" Value="{StaticResource UiFont}"/>
    <Setter Property="Margin" Value="18,16,14,6"/>
  </Style>

  <!-- 导航项 -->
  <Style x:Key="NavItem" TargetType="RadioButton">
    <Setter Property="FontFamily" Value="{StaticResource UiFont}"/>
    <Setter Property="FontSize" Value="13"/>
    <Setter Property="Foreground" Value="{StaticResource TextSoftBrush}"/>
    <Setter Property="Cursor" Value="Hand"/>
    <Setter Property="Margin" Value="8,1,8,1"/>
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="RadioButton">
          <Border x:Name="Root" Background="Transparent" CornerRadius="5"
                  Padding="10,8">
            <Grid>
              <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="*"/>
              </Grid.ColumnDefinitions>

              <!-- 选中时左侧的竖条指示器 -->
              <Border x:Name="Bar" Grid.Column="0" Width="3" Height="16"
                      CornerRadius="2" Background="Transparent"
                      Margin="0,0,9,0" VerticalAlignment="Center"/>

              <!-- 图标：用 Segoe MDL2 字体做矢量图标，省得挂一堆 png -->
              <TextBlock x:Name="Icon" Grid.Column="0" FontFamily="Segoe MDL2 Assets"
                         FontSize="14" Margin="0,0,8,0" VerticalAlignment="Center"
                         Text="{TemplateBinding Tag}" Opacity="0.75"/>

              <ContentPresenter Grid.Column="1" VerticalAlignment="Center"/>
            </Grid>
          </Border>

          <ControlTemplate.Triggers>
            <Trigger Property="IsMouseOver" Value="True">
              <Setter TargetName="Root" Property="Background" Value="{StaticResource HoverBrush}"/>
            </Trigger>
            <Trigger Property="IsChecked" Value="True">
              <Setter TargetName="Root" Property="Background" Value="{StaticResource SelectedBrush}"/>
              <Setter TargetName="Bar" Property="Background" Value="{StaticResource PrimaryBrush}"/>
              <Setter Property="Foreground" Value="{StaticResource PrimaryBrush}"/>
              <Setter Property="FontWeight" Value="SemiBold"/>
            </Trigger>
          </ControlTemplate.Triggers>
        </ControlTemplate>
      </Setter.Value>
    </Setter>
  </Style>

  <!-- ════════════════════════════════════════════════════════════
       按钮
       ════════════════════════════════════════════════════════════ -->

  <!-- 主按钮：实心蓝，用在大动作上（启动游戏） -->
  <Style x:Key="PrimaryButton" TargetType="Button">
    <Setter Property="FontFamily" Value="{StaticResource UiFont}"/>
    <Setter Property="FontSize" Value="14"/>
    <Setter Property="FontWeight" Value="SemiBold"/>
    <Setter Property="Foreground" Value="White"/>
    <Setter Property="Background" Value="{StaticResource PrimaryBrush}"/>
    <Setter Property="Cursor" Value="Hand"/>
    <Setter Property="Padding" Value="18,10"/>
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="Button">
          <Border x:Name="Bd" Background="{TemplateBinding Background}"
                  CornerRadius="6" Padding="{TemplateBinding Padding}">
            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
          </Border>
          <ControlTemplate.Triggers>
            <Trigger Property="IsMouseOver" Value="True">
              <Setter TargetName="Bd" Property="Opacity" Value="0.88"/>
            </Trigger>
            <Trigger Property="IsPressed" Value="True">
              <Setter TargetName="Bd" Property="Opacity" Value="0.75"/>
            </Trigger>
            <Trigger Property="IsEnabled" Value="False">
              <Setter TargetName="Bd" Property="Opacity" Value="0.4"/>
              <Setter Property="Cursor" Value="Arrow"/>
            </Trigger>
          </ControlTemplate.Triggers>
        </ControlTemplate>
      </Setter.Value>
    </Setter>
  </Style>

  <!-- 底部胶囊按钮：实心主色 + 大圆角长条。PCL 的设置页底部就是这个样子。 -->
  <Style x:Key="PillButton" TargetType="Button" BasedOn="{StaticResource PrimaryButton}">
    <Setter Property="Padding" Value="26,9"/>
    <Setter Property="FontSize" Value="13.5"/>
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="Button">
          <Border x:Name="Bd" Background="{TemplateBinding Background}"
                  CornerRadius="16" Padding="{TemplateBinding Padding}">
            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
          </Border>
          <ControlTemplate.Triggers>
            <Trigger Property="IsMouseOver" Value="True">
              <Setter TargetName="Bd" Property="Opacity" Value="0.88"/>
            </Trigger>
            <Trigger Property="IsPressed" Value="True">
              <Setter TargetName="Bd" Property="Opacity" Value="0.75"/>
            </Trigger>
            <Trigger Property="IsEnabled" Value="False">
              <Setter TargetName="Bd" Property="Opacity" Value="0.4"/>
              <Setter Property="Cursor" Value="Arrow"/>
            </Trigger>
          </ControlTemplate.Triggers>
        </ControlTemplate>
      </Setter.Value>
    </Setter>
  </Style>

  <!-- 次要按钮：白底描边 -->
  <Style x:Key="FlatButton" TargetType="Button">
    <Setter Property="FontFamily" Value="{StaticResource UiFont}"/>
    <Setter Property="FontSize" Value="12.5"/>
    <Setter Property="Foreground" Value="{StaticResource TextSoftBrush}"/>
    <Setter Property="Background" Value="{StaticResource CardBrush}"/>
    <Setter Property="Cursor" Value="Hand"/>
    <Setter Property="Padding" Value="12,7"/>
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="Button">
          <Border x:Name="Bd" Background="{TemplateBinding Background}"
                  BorderBrush="{StaticResource BorderBrush2}" BorderThickness="1"
                  CornerRadius="5" Padding="{TemplateBinding Padding}">
            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
          </Border>
          <ControlTemplate.Triggers>
            <Trigger Property="IsMouseOver" Value="True">
              <Setter TargetName="Bd" Property="Background" Value="{StaticResource HoverBrush}"/>
              <Setter TargetName="Bd" Property="BorderBrush" Value="{StaticResource PrimaryHiBrush}"/>
              <Setter Property="Foreground" Value="{StaticResource PrimaryBrush}"/>
            </Trigger>
            <Trigger Property="IsEnabled" Value="False">
              <Setter TargetName="Bd" Property="Opacity" Value="0.45"/>
              <Setter Property="Cursor" Value="Arrow"/>
            </Trigger>
          </ControlTemplate.Triggers>
        </ControlTemplate>
      </Setter.Value>
    </Setter>
  </Style>

  <!-- 顶栏按钮：透明度 + 图标 -->
  <Style x:Key="TopBarButton" TargetType="RadioButton">
    <Setter Property="FontFamily" Value="{StaticResource UiFont}"/>
    <Setter Property="FontSize" Value="13.5"/>
    <Setter Property="Foreground" Value="#DCFFFFFF"/>
    <Setter Property="Cursor" Value="Hand"/>
    <Setter Property="Margin" Value="2,0"/>
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="RadioButton">
          <Border x:Name="Bd" Background="Transparent" CornerRadius="4"
                  Padding="14,7">
            <StackPanel Orientation="Horizontal">
              <TextBlock x:Name="Ico" FontFamily="Segoe MDL2 Assets" FontSize="14"
                         Text="{TemplateBinding Tag}" Margin="0,0,7,0"
                         VerticalAlignment="Center"/>
              <ContentPresenter VerticalAlignment="Center"/>
            </StackPanel>
          </Border>
          <ControlTemplate.Triggers>
            <Trigger Property="IsMouseOver" Value="True">
              <Setter TargetName="Bd" Property="Background" Value="#30FFFFFF"/>
            </Trigger>
            <Trigger Property="IsChecked" Value="True">
              <Setter TargetName="Bd" Property="Background" Value="#FFFFFF"/>
              <Setter Property="Foreground" Value="{StaticResource PrimaryBrush}"/>
              <Setter Property="FontWeight" Value="SemiBold"/>
            </Trigger>
          </ControlTemplate.Triggers>
        </ControlTemplate>
      </Setter.Value>
    </Setter>
  </Style>

  <!-- ════════════════ 输入控件 ════════════════ -->

  <Style TargetType="TextBox">
    <Setter Property="FontFamily" Value="{StaticResource UiFont}"/>
    <Setter Property="FontSize" Value="13"/>
    <Setter Property="Foreground" Value="{StaticResource TextBrush}"/>
    <Setter Property="Background" Value="{StaticResource CardBrush}"/>
    <Setter Property="BorderBrush" Value="{StaticResource BorderBrush2}"/>
    <Setter Property="BorderThickness" Value="1"/>
    <Setter Property="Padding" Value="10,7"/>
    <Setter Property="CaretBrush" Value="{StaticResource PrimaryBrush}"/>
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="TextBox">
          <Border x:Name="Bd" Background="{TemplateBinding Background}"
                  BorderBrush="{TemplateBinding BorderBrush}"
                  BorderThickness="{TemplateBinding BorderThickness}"
                  CornerRadius="5">
            <ScrollViewer x:Name="PART_ContentHost" Margin="{TemplateBinding Padding}"
                          VerticalAlignment="Center"/>
          </Border>
          <ControlTemplate.Triggers>
            <Trigger Property="IsFocused" Value="True">
              <Setter TargetName="Bd" Property="BorderBrush" Value="{StaticResource PrimaryBrush}"/>
            </Trigger>
            <Trigger Property="IsMouseOver" Value="True">
              <Setter TargetName="Bd" Property="BorderBrush" Value="{StaticResource PrimaryHiBrush}"/>
            </Trigger>
          </ControlTemplate.Triggers>
        </ControlTemplate>
      </Setter.Value>
    </Setter>
  </Style>

  <!-- 下拉框：贴近 PCL2 那种「整行表单」的观感 -->
  <Style TargetType="ComboBox">
    <Setter Property="FontFamily" Value="{StaticResource UiFont}"/>
    <Setter Property="FontSize" Value="13"/>
    <Setter Property="Foreground" Value="{StaticResource TextBrush}"/>
    <Setter Property="Background" Value="{StaticResource CardBrush}"/>
    <Setter Property="BorderBrush" Value="{StaticResource BorderBrush2}"/>
    <Setter Property="Padding" Value="10,7"/>
    <Setter Property="MinHeight" Value="34"/>
  </Style>

  <!-- ════════════════ 滑块 ════════════════ -->
  <Style x:Key="NiceSlider" TargetType="Slider">
    <Setter Property="Height" Value="20"/>
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="Slider">
          <Grid VerticalAlignment="Center">
            <Border Height="5" CornerRadius="3" Background="{StaticResource BorderBrush2}"/>
            <Track x:Name="PART_Track">
              <Track.Thumb>
                <Thumb>
                  <Thumb.Template>
                    <ControlTemplate TargetType="Thumb">
                      <Ellipse x:Name="E" Width="15" Height="15"
                               Fill="{StaticResource PrimaryBrush}"
                               Stroke="White" StrokeThickness="2"/>
                      <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                          <Setter TargetName="E" Property="Fill" Value="{StaticResource PrimaryHiBrush}"/>
                        </Trigger>
                      </ControlTemplate.Triggers>
                    </ControlTemplate>
                  </Thumb.Template>
                </Thumb>
              </Track.Thumb>
            </Track>
          </Grid>
        </ControlTemplate>
      </Setter.Value>
    </Setter>
  </Style>

  <!-- ════════════════ 滚动条（细） ════════════════ -->
  <Style x:Key="ThinScroll" TargetType="ScrollBar">
    <Setter Property="Width" Value="8"/>
    <Setter Property="Background" Value="Transparent"/>
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="ScrollBar">
          <Track x:Name="PART_Track" IsDirectionReversed="True">
            <Track.Thumb>
              <Thumb>
                <Thumb.Template>
                  <ControlTemplate TargetType="Thumb">
                    <Border Background="#40000000" CornerRadius="4" Margin="2,0"/>
                  </ControlTemplate>
                </Thumb.Template>
              </Thumb>
            </Track.Thumb>
          </Track>
        </ControlTemplate>
      </Setter.Value>
    </Setter>
  </Style>

  <!-- ════════════════ 进度条 ════════════════ -->
  <Style x:Key="ThinProgress" TargetType="ProgressBar">
    <Setter Property="Height" Value="6"/>
    <Setter Property="Foreground" Value="{StaticResource PrimaryBrush}"/>
    <Setter Property="Background" Value="{StaticResource BorderBrush2}"/>
    <Setter Property="BorderThickness" Value="0"/>
  </Style>

  <!-- ════════════════ 折叠区块（用于「高级选项」） ════════════════ -->
  <Style x:Key="FoldHeader" TargetType="ToggleButton">
    <Setter Property="FontFamily" Value="{StaticResource UiFont}"/>
    <Setter Property="FontSize" Value="13.5"/>
    <Setter Property="FontWeight" Value="SemiBold"/>
    <Setter Property="Foreground" Value="{StaticResource TextBrush}"/>
    <Setter Property="Background" Value="{StaticResource CardBrush}"/>
    <Setter Property="Cursor" Value="Hand"/>
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="ToggleButton">
          <Border Background="{TemplateBinding Background}"
                  BorderBrush="{StaticResource BorderBrush2}" BorderThickness="1"
                  CornerRadius="6" Padding="16,12">
            <Grid>
              <ContentPresenter VerticalAlignment="Center"/>
              <TextBlock x:Name="Chev" Text="&#xE70D;" FontFamily="Segoe MDL2 Assets"
                         FontSize="11" Foreground="{StaticResource TextMutedBrush}"
                         HorizontalAlignment="Right" VerticalAlignment="Center"/>
            </Grid>
          </Border>
          <ControlTemplate.Triggers>
            <Trigger Property="IsMouseOver" Value="True">
              <Setter Property="Foreground" Value="{StaticResource PrimaryBrush}"/>
            </Trigger>
            <Trigger Property="IsChecked" Value="True">
              <Setter TargetName="Chev" Property="Text" Value="&#xE70E;"/>
            </Trigger>
          </ControlTemplate.Triggers>
        </ControlTemplate>
      </Setter.Value>
    </Setter>
  </Style>

  <!-- ════════════════ 等距方块图标（下载页的版本分类图标） ════════════════ -->

  <Style TargetType="{x:Type local:BlockGlyph}">
    <Setter Property="Width" Value="34"/>
    <Setter Property="Height" Value="34"/>
    <Setter Property="SnapsToDevicePixels" Value="False"/>
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="{x:Type local:BlockGlyph}">
          <!-- 用 Viewbox 包住，尺寸随 Width/Height 缩放而线条不糊 -->
          <Viewbox Stretch="Uniform">
            <Canvas Width="32" Height="32">
              <!-- 顶面：菱形 -->
              <Polygon Points="16,1 31,8.5 16,16 1,8.5"
                       Fill="{TemplateBinding TopBrush}"/>
              <!-- 左面 -->
              <Polygon Points="1,8.5 16,16 16,31 1,23.5"
                       Fill="{TemplateBinding LeftBrush}"/>
              <!-- 右面 -->
              <Polygon Points="31,8.5 31,23.5 16,31 16,16"
                       Fill="{TemplateBinding RightBrush}"/>
              <!-- 棱线：纯色块拼一起会有缝，描一道同色边把它压实 -->
              <Polygon Points="16,1 31,8.5 16,16 1,8.5"
                       Stroke="{TemplateBinding TopBrush}" StrokeThickness="0.6"/>
              <Polygon Points="1,8.5 16,16 16,31 1,23.5"
                       Stroke="{TemplateBinding LeftBrush}" StrokeThickness="0.6"/>
              <Polygon Points="31,8.5 31,23.5 16,31 16,16"
                       Stroke="{TemplateBinding RightBrush}" StrokeThickness="0.6"/>
            </Canvas>
          </Viewbox>
        </ControlTemplate>
      </Setter.Value>
    </Setter>
  </Style>

  <!-- ════════════════ 启动页的大按钮 ════════════════

       PCL 的「启动游戏」不是实心块，是白底 + 一圈主色描边 + 主色文字。比实心块轻，也不和底下的次要按钮抢视觉。       ════════════════════════════════════════════════════════════ -->
  <Style x:Key="HeroButton" TargetType="Button">
    <Setter Property="FontFamily" Value="{StaticResource UiFont}"/>
    <Setter Property="Cursor" Value="Hand"/>
    <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="Button">
          <Border x:Name="Bd" Background="{StaticResource CardBrush}"
                  BorderBrush="{Binding RunButtonBrush}"
                  BorderThickness="1.5" CornerRadius="6" Padding="14,9">
            <StackPanel VerticalAlignment="Center">
              <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                <TextBlock Text="&#xE768;" FontFamily="Segoe MDL2 Assets" FontSize="13"
                           VerticalAlignment="Center"
                           Foreground="{Binding RunButtonBrush}"/>
                <TextBlock Text="{Binding RunButtonText}" FontSize="14.5" FontWeight="SemiBold"
                           Margin="7,0,0,0" VerticalAlignment="Center"
                           Foreground="{Binding RunButtonBrush}"/>
              </StackPanel>
              <TextBlock Text="{Binding RunSubtitle}" FontSize="11"
                         Foreground="{StaticResource TextMutedBrush}"
                         HorizontalAlignment="Center" Margin="0,3,0,0"
                         TextTrimming="CharacterEllipsis"/>
            </StackPanel>
          </Border>
          <ControlTemplate.Triggers>
            <Trigger Property="IsMouseOver" Value="True">
              <Setter TargetName="Bd" Property="Background" Value="{StaticResource HoverBrush}"/>
            </Trigger>
            <Trigger Property="IsPressed" Value="True">
              <Setter TargetName="Bd" Property="Background" Value="{StaticResource SelectedBrush}"/>
            </Trigger>
            <Trigger Property="IsEnabled" Value="False">
              <Setter TargetName="Bd" Property="Opacity" Value="0.5"/>
            </Trigger>
          </ControlTemplate.Triggers>
        </ControlTemplate>
      </Setter.Value>
    </Setter>
  </Style>

</ResourceDictionary>