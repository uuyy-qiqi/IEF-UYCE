<Window x:Class="PclLike.Gui.JavaPickDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="下载 Java 运行时" Height="330" Width="440"
        Icon="Assets/pclike.png"
        Background="{StaticResource BgBrush}"
        WindowStartupLocation="CenterOwner"
        ResizeMode="NoResize"
        UseLayoutRounding="True" SnapsToDevicePixels="True">

  <Grid Margin="20">
    <Grid.RowDefinitions>
      <RowDefinition Height="*"/>
      <RowDefinition Height="Auto"/>
    </Grid.RowDefinitions>

    <StackPanel Grid.Row="0">
      <TextBlock Text="选择要下载的 Java 大版本" FontSize="15" FontWeight="Bold"
                 Foreground="{StaticResource AccentHiBrush}" Margin="0,0,0,6"/>
      <TextBlock Text="从 Adoptium（Temurin JRE）下载，解压到 游戏目录\runtime\，装好在「设置 → Java」里自动选中。"
                 FontSize="11.5" TextWrapping="Wrap"
                 Foreground="{StaticResource MutedBrush}" Margin="0,0,0,14"/>

      <RadioButton x:Name="Pick8" GroupName="JavaMajor" Margin="0,0,0,10">
        <StackPanel>
          <TextBlock Text="Java 8" FontSize="13" FontWeight="SemiBold"/>
          <TextBlock Text="Minecraft 1.16.5 及更早" FontSize="11"
                     Foreground="{StaticResource MutedBrush}"/>
        </StackPanel>
      </RadioButton>

      <RadioButton x:Name="Pick17" GroupName="JavaMajor" Margin="0,0,0,10">
        <StackPanel>
          <TextBlock Text="Java 17" FontSize="13" FontWeight="SemiBold"/>
          <TextBlock Text="Minecraft 1.17 ~ 1.20.4（含对应 Forge / Fabric / NeoForge）" FontSize="11"
                     Foreground="{StaticResource MutedBrush}"/>
        </StackPanel>
      </RadioButton>

      <RadioButton x:Name="Pick21" GroupName="JavaMajor">
        <StackPanel>
          <TextBlock Text="Java 21" FontSize="13" FontWeight="SemiBold"/>
          <TextBlock Text="Minecraft 1.20.5 及更新（含 1.21 系列）" FontSize="11"
                     Foreground="{StaticResource MutedBrush}"/>
        </StackPanel>
      </RadioButton>
    </StackPanel>

    <StackPanel Grid.Row="1" Orientation="Horizontal" HorizontalAlignment="Right"
                Margin="0,16,0,0">
      <Button Content="取消" Style="{StaticResource FlatButton}" Padding="18,6"
              Click="Cancel_Click" Margin="0,0,8,0"/>
      <Button Content="开始下载" Style="{StaticResource PrimaryButton}" Padding="18,6"
              Click="Ok_Click"/>
    </StackPanel>
  </Grid>
</Window>