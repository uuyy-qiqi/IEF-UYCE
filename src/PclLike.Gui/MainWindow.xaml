<Window x:Class="PclLike.Gui.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:local="clr-namespace:PclLike.Gui"
        xmlns:skins="clr-namespace:PclLike.Gui.Skins"
        Title="PclLike 启动器" Height="720" Width="1120"
        Icon="Assets/pclike.png"
        MinHeight="560" MinWidth="900"
        Background="{StaticResource BgBrush}"
        WindowStyle="None"
        AllowsTransparency="True"
        WindowStartupLocation="CenterScreen"
        UseLayoutRounding="True" SnapsToDevicePixels="True"
        TextOptions.TextFormattingMode="Display"
        FontFamily="{StaticResource UiFont}"
        d:DataContext="{d:DesignInstance local:MainViewModel}"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        mc:Ignorable="d">

  <WindowChrome.WindowChrome>
    <!-- 无边框窗口：原生标题栏和自绘顶栏会重复（顶栏里那对最小化/关闭按钮
         本来就是照无边框画的），所以干脆把原生的一整条去掉。
         CaptionHeight=0 → 整个窗口都是客户区，拖动由顶栏自己处理；
         ResizeBorderThickness 留着，边缘还能拖动改大小；
         GlassFrameThickness=1 → 让 DWM 照常画外框和投影，窗口才浮得起来。 -->
    <WindowChrome CaptionHeight="0" ResizeBorderThickness="6"
                  GlassFrameThickness="1" CornerRadius="0"
                  UseAeroCaptionButtons="False"/>
  </WindowChrome.WindowChrome>

  <Window.Resources>
    <!-- ══════════════════════════════════════════════════════════
         版本行模板：正式版/预览版/远古版/愚人节版四个列表共用。
         行高写死 38 —— 徽章是两行文字旁边的小方块，如果让内容自己撑高度，
         徽章会被裁掉下面一半；给个固定高度让徽章垂直居中就稳了。
         ══════════════════════════════════════════════════════════ -->
    <DataTemplate x:Key="VersionRowTemplate" DataType="{x:Type local:VersionItem}">
      <Grid Height="38">
        <Grid.ColumnDefinitions>
          <ColumnDefinition Width="*" MinWidth="120"/>
          <ColumnDefinition Width="80"/>
        </Grid.ColumnDefinitions>
        <StackPanel Grid.Column="0" VerticalAlignment="Center">
          <TextBlock Text="{Binding Display}" FontSize="13.5" FontWeight="SemiBold"
                     TextTrimming="CharacterEllipsis"/>
          <TextBlock Text="{Binding ReleaseDate}" FontSize="11"
                     Foreground="{StaticResource TextMutedBrush}"/>
        </StackPanel>
        <Border Grid.Column="1" CornerRadius="3" Padding="8,1,8,3"
                Background="{StaticResource SelectedBrush}"
                VerticalAlignment="Center" HorizontalAlignment="Left">
          <!-- 不设 LineHeight：中文字体（微软雅黑）的行高比字号大不少，
               强行压成小值会把字的下半截裁掉。 -->
          <TextBlock Text="{Binding TypeLabel}" FontSize="11"
                     Foreground="{StaticResource PrimaryBrush}"/>
        </Border>
      </Grid>
    </DataTemplate>
  </Window.Resources>

  <Grid>
    <Grid.RowDefinitions>
      <RowDefinition Height="Auto"/>
      <RowDefinition Height="*"/>
    </Grid.RowDefinitions>

    <!-- ══════════════════════════════════════════════════════════
         顶栏：蓝色底 + 居中四个大页签 + 右侧账号/窗口按钮
         ══════════════════════════════════════════════════════════ -->
    <Border Grid.Row="0" Background="{StaticResource TopBarBrush}" Padding="0"
            MouseLeftButtonDown="TopBar_MouseDown">
      <Grid Height="52">
        <Grid.ColumnDefinitions>
          <ColumnDefinition Width="Auto"/>
          <ColumnDefinition Width="*"/>
          <ColumnDefinition Width="Auto"/>
        </Grid.ColumnDefinitions>

        <!-- 左：Logo -->
        <StackPanel Grid.Column="0" Orientation="Horizontal"
                    VerticalAlignment="Center" Margin="18,0,0,0">
          <TextBlock Text="PCL" FontSize="19" FontWeight="Bold" Foreground="White"
                     VerticalAlignment="Center"/>
          <Border Background="#40FFFFFF" CornerRadius="3" Padding="5,2"
                  Margin="7,0,0,0" VerticalAlignment="Center">
            <TextBlock Text="CE" FontSize="11" FontWeight="SemiBold" Foreground="White"/>
          </Border>
        </StackPanel>

        <!-- 中：四个主页签（居中） -->
        <StackPanel Grid.Column="1" Orientation="Horizontal"
                    HorizontalAlignment="Center" VerticalAlignment="Center">
          <RadioButton x:Name="TabLaunch" Content="启动" Tag="&#xE768;"
                       GroupName="TopTab" IsChecked="True"
                       Style="{StaticResource TopBarButton}" Click="Tab_Click"/>
          <RadioButton x:Name="TabDownload" Content="下载" Tag="&#xE896;"
                       GroupName="TopTab"
                       Style="{StaticResource TopBarButton}" Click="Tab_Click"/>
          <RadioButton x:Name="TabSettings" Content="设置" Tag="&#xE713;"
                       GroupName="TopTab"
                       Style="{StaticResource TopBarButton}" Click="Tab_Click"/>
          <RadioButton x:Name="TabTools" Content="工具" Tag="&#xE90F;"
                       GroupName="TopTab"
                       Style="{StaticResource TopBarButton}" Click="Tab_Click"/>
        </StackPanel>

        <!-- 右：账号入口 + 窗口控制 -->
        <StackPanel Grid.Column="2" Orientation="Horizontal"
                    VerticalAlignment="Center" Margin="0,0,8,0">

          <!-- 状态 + 进度。原来这一块占着窗口底部一整条（旁边还挂着一个日志抽屉），
               压在左栏的启动按钮下面真的碍眼。现在整个搬进顶栏：
               进度条只在忙的时候出现，状态文字平时就一句「就绪」，
               想翻历史看日志去 工具 → 百宝箱 → 启动器日志（那是独立窗口）。 -->
          <StackPanel x:Name="TopBarStatus" Orientation="Horizontal"
                      VerticalAlignment="Center" Margin="0,0,14,0">
            <ProgressBar x:Name="TopProgress" Style="{StaticResource ThinProgress}"
                         Width="76" VerticalAlignment="Center"
                         Visibility="{Binding IsBusy, Converter={StaticResource BoolVis}}"
                         Value="{Binding ProgressValue, Mode=OneWay}"
                         Maximum="{Binding ProgressMax, Mode=OneWay}"
                         IsIndeterminate="{Binding IsProgressIndeterminate, Mode=OneWay}"/>
            <TextBlock x:Name="TopStatusText" Text="{Binding StatusText}" FontSize="11.5"
                       Foreground="#D8E5FF" VerticalAlignment="Center" Margin="8,0,0,0"
                       MaxWidth="260" TextTrimming="CharacterEllipsis"
                       ToolTip="{Binding StatusText}"/>
          </StackPanel>

          <Button x:Name="AccountButton" Click="Account_Click"
                  Background="Transparent" BorderThickness="0" Padding="8,4"
                  Cursor="Hand" ToolTip="{Binding AccountTooltip}">
            <Button.Template>
              <ControlTemplate TargetType="Button">
                <Border x:Name="Bd" Background="Transparent" CornerRadius="4" Padding="9,5">
                  <ContentPresenter/>
                </Border>
                <ControlTemplate.Triggers>
                  <Trigger Property="IsMouseOver" Value="True">
                    <Setter TargetName="Bd" Property="Background" Value="#30FFFFFF"/>
                  </Trigger>
                </ControlTemplate.Triggers>
              </ControlTemplate>
            </Button.Template>
            <StackPanel Orientation="Horizontal">
              <Border x:Name="AvatarBox" Width="22" Height="22" CornerRadius="11"
                      Background="#40FFFFFF" VerticalAlignment="Center">
                <TextBlock x:Name="AvatarInitial" Text="{Binding AccountInitial}"
                           FontSize="11" FontWeight="Bold" Foreground="White"
                           HorizontalAlignment="Center" VerticalAlignment="Center"/>
              </Border>
              <TextBlock x:Name="AccountLabel" Text="{Binding AccountLabel}" FontSize="13"
                         Margin="7,0,0,0" VerticalAlignment="Center" Foreground="White"/>
            </StackPanel>
          </Button>

          <!-- 最小化 / 关闭（自绘，配合无边框顶栏的观感） -->
          <Button Click="Minimize_Click" Cursor="Hand" Background="Transparent"
                  BorderThickness="0" Width="34" Height="34">
            <Button.Template>
              <ControlTemplate TargetType="Button">
                <Border x:Name="Bd" Background="Transparent">
                  <TextBlock Text="&#xE921;" FontFamily="Segoe MDL2 Assets" FontSize="11"
                             Foreground="White" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                </Border>
                <ControlTemplate.Triggers>
                  <Trigger Property="IsMouseOver" Value="True">
                    <Setter TargetName="Bd" Property="Background" Value="#30FFFFFF"/>
                  </Trigger>
                </ControlTemplate.Triggers>
              </ControlTemplate>
            </Button.Template>
          </Button>

          <!-- 最大化 / 还原。原生标题栏去掉以后这个按钮是唯一的最大化入口，所以必须有。 -->
          <Button x:Name="MaxButton" Click="Maximize_Click" Cursor="Hand" Background="Transparent"
                  BorderThickness="0" Width="34" Height="34" ToolTip="最大化 / 还原">
            <Button.Template>
              <ControlTemplate TargetType="Button">
                <Border x:Name="Bd" Background="Transparent">
                  <TextBlock x:Name="Glyph" Text="&#xE922;" FontFamily="Segoe MDL2 Assets" FontSize="11"
                             Foreground="White" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                </Border>
                <ControlTemplate.Triggers>
                  <Trigger Property="IsMouseOver" Value="True">
                    <Setter TargetName="Bd" Property="Background" Value="#30FFFFFF"/>
                  </Trigger>
                </ControlTemplate.Triggers>
              </ControlTemplate>
            </Button.Template>
          </Button>

          <Button Click="Close_Click" Cursor="Hand" Background="Transparent"
                  BorderThickness="0" Width="34" Height="34">
            <Button.Template>
              <ControlTemplate TargetType="Button">
                <Border x:Name="Bd" Background="Transparent">
                  <TextBlock Text="&#xE8BB;" FontFamily="Segoe MDL2 Assets" FontSize="11"
                             Foreground="White" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                </Border>
                <ControlTemplate.Triggers>
                  <Trigger Property="IsMouseOver" Value="True">
                    <Setter TargetName="Bd" Property="Background" Value="#D9534F"/>
                  </Trigger>
                </ControlTemplate.Triggers>
              </ControlTemplate>
            </Button.Template>
          </Button>
        </StackPanel>
      </Grid>
    </Border>

    <!-- ══════════════════════════════════════════════════════════
         主体：左侧导航 + 右侧内容
         ══════════════════════════════════════════════════════════ -->
    <Grid Grid.Row="1">
      <Grid.ColumnDefinitions>
        <ColumnDefinition Width="216"/>
        <ColumnDefinition Width="*"/>
      </Grid.ColumnDefinitions>

      <!-- ── 左栏 ──
           上面常驻人卡，下面按大页签二选一：非启动页是分组导航，启动页让位给启动按钮。
           人卡不画卡片底、不画边框，只留头像 + 名字，直接浮在毛玻璃上。 -->
      <Border Grid.Column="0" Background="{StaticResource RailBrush}"
              BorderBrush="{StaticResource BorderBrush2}" BorderThickness="0,0,1,0">
        <Grid>
          <Grid.RowDefinitions>
            <RowDefinition x:Name="PlayerSection" Height="Auto"/>
            <RowDefinition x:Name="NavSection" Height="*"/>
          </Grid.RowDefinitions>

          <!-- 人卡：四个大页签下都在 —— 换页不该把玩家身份藏起来。
               启动页里它是"上半格垂直居中"（和 PCL CE 一样），其它页回到顶部、
               把高度让给导航列表；这两件事由 ShowTopTab 切 RowDefinition 完成。 -->
          <Border x:Name="PlayerHost" Grid.Row="0" Background="Transparent"
                  VerticalAlignment="Top">
            <Button Click="Account_Click" Cursor="Hand"
                    Background="Transparent" BorderThickness="0"
                    HorizontalAlignment="Stretch" VerticalAlignment="Center"
                    ToolTip="点击切换账号">
              <Button.Template>
                <ControlTemplate TargetType="Button">
                  <Border x:Name="Bd" Background="Transparent">
                    <ContentPresenter HorizontalAlignment="Stretch" VerticalAlignment="Top"/>
                  </Border>
                  <ControlTemplate.Triggers>
                    <Trigger Property="IsMouseOver" Value="True">
                      <Setter TargetName="Bd" Property="Background" Value="{StaticResource HoverBrush}"/>
                    </Trigger>
                  </ControlTemplate.Triggers>
                </ControlTemplate>
              </Button.Template>

              <StackPanel Margin="16,18,16,14">
                <!-- 头像位：真实皮肤走 SkinHeadView（平铺的 2D 方脸，PCL CE 就长这样），
                     查不到皮肤就显示 avatar_fallback.png 那张方脸。
                     两张图叠在同一格里靠 Visibility 切换 —— 这样猫图能用高质量缩放，
                     皮肤图仍然保持最近邻（8×8 放大成 92px，插值一糊就毁了）。 -->
                <Grid HorizontalAlignment="Center">
                  <Image x:Name="PlayerFallback" Width="92" Height="92"
                         Stretch="UniformToFill"
                         RenderOptions.BitmapScalingMode="HighQuality"
                         Source="pack://application:,,,/Assets/avatar_fallback.png"/>

                  <skins:SkinHeadView x:Name="PlayerHead" Size="92" Flat="True"
                                      Visibility="Collapsed"/>
                </Grid>

                <TextBlock x:Name="PlayerNameText" Text="{Binding Username}"
                           FontSize="15.5" FontWeight="SemiBold"
                           Foreground="{StaticResource TextBrush}"
                           HorizontalAlignment="Center" Margin="0,10,0,0"
                           MaxWidth="184" TextTrimming="CharacterEllipsis"/>

                <TextBlock x:Name="PlayerAuthText" Text="离线模式"
                           FontSize="11.5" Foreground="{StaticResource TextMutedBrush}"
                           HorizontalAlignment="Center" Margin="0,3,0,0"/>
              </StackPanel>
            </Button>
          </Border>

          <Grid Grid.Row="1">
            <!-- 导航（非启动页） -->
            <Border x:Name="NavHost" Background="Transparent">
              <ScrollViewer VerticalScrollBarVisibility="Auto" Padding="0,4,0,12">
                <StackPanel x:Name="NavPanel">
                  <!-- 内容随当前大页签变化，由代码切换 -->
                </StackPanel>
              </ScrollViewer>
            </Border>

            <!-- 启动按钮区（只在启动页） -->
            <StackPanel x:Name="LaunchActions" Visibility="Collapsed"
                        VerticalAlignment="Bottom" Margin="14,0,14,16">
              <Button x:Name="RunButton" Style="{StaticResource HeroButton}"
                      Click="Run_Click" IsEnabled="{Binding CanLaunch}"/>

              <Grid Margin="0,10,0,0">
                <Grid.ColumnDefinitions>
                  <ColumnDefinition Width="*"/>
                  <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>
                <Button Grid.Column="0" Content="实例选择" Style="{StaticResource FlatButton}"
                        Margin="0,0,4,0" Padding="4,9" Click="InstancePick_Click"/>
                <Button Grid.Column="1" Content="实例设置" Style="{StaticResource FlatButton}"
                        Margin="4,0,0,0" Padding="4,9" Click="InstanceSettings_Click"/>
              </Grid>
            </StackPanel>
          </Grid>
        </Grid>
      </Border>

      <!-- ── 右：内容区 ── -->
      <Grid Grid.Column="1">

        <!-- ════ 启动页 ════ -->
        <ScrollViewer x:Name="PageLaunch" Visibility="Visible"
                      VerticalScrollBarVisibility="Auto" Padding="22,18,22,18">
          <StackPanel>

            <!-- 没 Java 的警告。放最上面，因为这是唯一会挡住启动的东西。 -->
            <Border x:Name="NoJavaBox" Visibility="Collapsed"
                    Background="#FFF7E8" BorderBrush="#F0D9A8" BorderThickness="1"
                    CornerRadius="6" Padding="16,13" Margin="0,0,0,12">
              <Grid>
                <Grid.ColumnDefinitions>
                  <ColumnDefinition Width="Auto"/>
                  <ColumnDefinition Width="*"/>
                  <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <TextBlock Grid.Column="0" Text="&#xE7BA;" FontFamily="Segoe MDL2 Assets"
                           FontSize="17" Foreground="#B8860B" VerticalAlignment="Top"
                           Margin="0,1,12,0"/>
                <StackPanel Grid.Column="1">
                  <TextBlock Text="没有找到 Java 运行时" FontSize="13.5" FontWeight="SemiBold"
                             Foreground="#8A6A20"/>
                  <TextBlock Text="没有 Java 游戏起不来。去「设置 → Java」扫一下，或者让启动器自动下载一个。"
                             FontSize="12" Foreground="#8A6A20" TextWrapping="Wrap" Margin="0,3,0,0"/>
                </StackPanel>
                <Button Grid.Column="2" Content="去设置" Style="{StaticResource FlatButton}"
                        Padding="12,7" VerticalAlignment="Center" Click="GoJava_Click"/>
              </Grid>
            </Border>

            <!-- 当前实例 -->
            <Border Style="{StaticResource Card}">
              <StackPanel>
                <Grid Margin="0,0,0,13">
                  <TextBlock Text="当前实例" FontSize="14" FontWeight="SemiBold"
                             Foreground="{StaticResource TextBrush}" VerticalAlignment="Center"/>
                  <Button Content="管理实例" Style="{StaticResource FlatButton}" Padding="12,6"
                          HorizontalAlignment="Right" VerticalAlignment="Center"
                          Click="InstancePick_Click"/>
                </Grid>

                <Grid>
                  <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                  </Grid.ColumnDefinitions>

                  <local:BlockGlyph Grid.Column="0" Width="42" Height="42"
                                    TopBrush="#7CB342" LeftBrush="#5A8F2E" RightBrush="#4A7824"
                                    Margin="0,0,14,0" VerticalAlignment="Center"/>

                  <StackPanel Grid.Column="1" VerticalAlignment="Center">
                    <TextBlock Text="{Binding InstanceLabel}" FontSize="15.5"
                               FontWeight="SemiBold" Foreground="{StaticResource TextBrush}"
                               TextTrimming="CharacterEllipsis"/>
                    <TextBlock Text="{Binding SelectedVersionLabel}" FontSize="11.5"
                               Foreground="{StaticResource TextMutedBrush}" Margin="0,3,0,0"/>
                    <TextBlock x:Name="InstancePathText" FontSize="11"
                               Foreground="{StaticResource TextMutedBrush}" Margin="0,3,0,0"
                               TextTrimming="CharacterEllipsis"/>
                  </StackPanel>
                </Grid>

                <!-- Java / 内存 / 游戏目录 -->
                <Border Background="{StaticResource BgBrush}" CornerRadius="5"
                        Padding="13,11" Margin="0,14,0,0">
                  <Grid>
                    <Grid.ColumnDefinitions>
                      <ColumnDefinition Width="*"/>
                      <ColumnDefinition Width="*"/>
                      <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>

                    <StackPanel Grid.Column="0" Margin="0,0,10,0">
                      <TextBlock Text="Java" FontSize="11" Foreground="{StaticResource TextMutedBrush}"/>
                      <TextBlock Text="{Binding JavaSummary}" FontSize="12.5"
                                 Foreground="{StaticResource TextBrush}" Margin="0,3,0,0"
                                 TextTrimming="CharacterEllipsis"/>
                    </StackPanel>

                    <StackPanel Grid.Column="1" Margin="0,0,10,0">
                      <TextBlock Text="内存" FontSize="11" Foreground="{StaticResource TextMutedBrush}"/>
                      <TextBlock Text="{Binding MemorySummary}" FontSize="12.5"
                                 Foreground="{StaticResource TextBrush}" Margin="0,3,0,0"/>
                    </StackPanel>

                    <Button Grid.Column="2" Content="打开目录" Style="{StaticResource FlatButton}"
                            Padding="12,7" VerticalAlignment="Center" Click="OpenFolder_Click"/>
                  </Grid>
                </Border>
              </StackPanel>
            </Border>

            <!-- 快捷入口 -->
            <Border Style="{StaticResource Card}">
              <StackPanel>
                <TextBlock Text="快速开始" FontSize="14" FontWeight="SemiBold"
                           Foreground="{StaticResource TextBrush}" Margin="0,0,0,12"/>
                <WrapPanel>
                  <Button Content="下载新版本" Style="{StaticResource FlatButton}" Padding="16,10"
                          Margin="0,0,8,8" Click="GoDownload_Click"/>
                  <Button Content="安装／补全文件" Style="{StaticResource FlatButton}" Padding="16,10"
                          Margin="0,0,8,8" Click="Install_Click"/>
                  <Button Content="Mod 管理" Style="{StaticResource FlatButton}" Padding="16,10"
                          Margin="0,0,8,8" Click="Mods_Click"/>
                  <Button Content="实例选择" Style="{StaticResource FlatButton}" Padding="16,10"
                          Margin="0,0,8,8" Click="InstancePick_Click"/>
                </WrapPanel>
              </StackPanel>
            </Border>

          </StackPanel>
        </ScrollViewer>

        <!-- ════ 下载页 ════ -->
        <ScrollViewer x:Name="PageDownload" Visibility="Collapsed"
                      VerticalScrollBarVisibility="Auto" Padding="22,18,22,18">
          <StackPanel>
            <!-- 最新版本 -->
            <Border Style="{StaticResource Card}">
              <StackPanel>
                <TextBlock Text="最新版本" FontSize="14" FontWeight="SemiBold"
                           Foreground="{StaticResource TextBrush}" Margin="0,0,0,12"/>

                <Border Style="{StaticResource CardRow}" Margin="0,0,0,6">
                  <Grid>
                    <Grid.ColumnDefinitions>
                      <ColumnDefinition Width="Auto"/>
                      <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    <local:BlockGlyph Grid.Column="0" Width="30" Height="30"
                                      TopBrush="#7CB342" LeftBrush="#5A8F2E" RightBrush="#4A7824"
                                      Margin="0,0,12,0" VerticalAlignment="Center"/>
                    <StackPanel Grid.Column="1" VerticalAlignment="Center">
                      <TextBlock Text="{Binding LatestReleaseLabel}" FontSize="13.5"
                                 FontWeight="SemiBold" Foreground="{StaticResource TextBrush}"/>
                      <TextBlock Text="{Binding LatestReleaseSub}" FontSize="11.5"
                                 Foreground="{StaticResource TextMutedBrush}" Margin="0,2,0,0"/>
                    </StackPanel>
                  </Grid>
                </Border>

                <Border Style="{StaticResource CardRow}" Margin="0">
                  <Grid>
                    <Grid.ColumnDefinitions>
                      <ColumnDefinition Width="Auto"/>
                      <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    <local:BlockGlyph Grid.Column="0" Width="30" Height="30"
                                      TopBrush="#D9A05B" LeftBrush="#B4803C" RightBrush="#96682F"
                                      Margin="0,0,12,0" VerticalAlignment="Center"/>
                    <StackPanel Grid.Column="1" VerticalAlignment="Center">
                      <TextBlock Text="{Binding LatestSnapshotLabel}" FontSize="13.5"
                                 FontWeight="SemiBold" Foreground="{StaticResource TextBrush}"/>
                      <TextBlock Text="{Binding LatestSnapshotSub}" FontSize="11.5"
                                 Foreground="{StaticResource TextMutedBrush}" Margin="0,2,0,0"/>
                    </StackPanel>
                  </Grid>
                </Border>
              </StackPanel>
            </Border>

            <!-- 版本分类折叠 + 列表。
                 四个分类各有一份独立的 ICollectionView（共用同一份 Versions 数据，
                 只是过滤条件不同），所以展开/收起一个不影响其他。
                 PCL 也是默认全部收起，这里同样只让「正式版」默认展开。 -->
            <ToggleButton x:Name="FoldRelease" Style="{StaticResource FoldHeader}"
                          Content="{Binding ReleaseFoldLabel}" IsChecked="True"
                          Margin="0,0,0,0" Click="Fold_Click"/>
            <Border x:Name="PanelRelease" Style="{StaticResource Card}"
                    Margin="0,0,0,12" Padding="6,8">
              <ListBox x:Name="VersionListBox" Style="{StaticResource VersionList}"
                       ItemContainerStyle="{StaticResource VersionItem}"
                       ItemTemplate="{StaticResource VersionRowTemplate}"
                       ItemsSource="{Binding ReleasesView}"
                       SelectedItem="{Binding SelectedVersion, Mode=TwoWay}"
                       MaxHeight="300"/>
            </Border>

            <ToggleButton x:Name="FoldSnapshot" Style="{StaticResource FoldHeader}"
                          Content="{Binding SnapshotFoldLabel}"
                          Margin="0,0,0,0" Click="Fold_Click"/>
            <Border x:Name="PanelSnapshot" Style="{StaticResource Card}"
                    Visibility="Collapsed" Margin="0,0,0,12" Padding="6,8">
              <ListBox Style="{StaticResource VersionList}"
                       ItemContainerStyle="{StaticResource VersionItem}"
                       ItemTemplate="{StaticResource VersionRowTemplate}"
                       ItemsSource="{Binding SnapshotsView}"
                       SelectedItem="{Binding SelectedVersion, Mode=TwoWay}"
                       MaxHeight="300"/>
            </Border>

            <ToggleButton x:Name="FoldOld" Style="{StaticResource FoldHeader}"
                          Content="{Binding OldFoldLabel}"
                          Margin="0,0,0,0" Click="Fold_Click"/>
            <Border x:Name="PanelOld" Style="{StaticResource Card}"
                    Visibility="Collapsed" Margin="0,0,0,12" Padding="6,8">
              <ListBox Style="{StaticResource VersionList}"
                       ItemContainerStyle="{StaticResource VersionItem}"
                       ItemTemplate="{StaticResource VersionRowTemplate}"
                       ItemsSource="{Binding OldView}"
                       SelectedItem="{Binding SelectedVersion, Mode=TwoWay}"
                       MaxHeight="300"/>
            </Border>

            <!-- 愚人节版：没有就整块不出现 -->
            <ToggleButton x:Name="FoldJoke" Style="{StaticResource FoldHeader}"
                          Content="{Binding JokeFoldLabel}"
                          Visibility="{Binding HasJokeVersions, Converter={StaticResource BoolVis}}"
                          Margin="0,0,0,0" Click="Fold_Click"/>
            <Border x:Name="PanelJoke" Style="{StaticResource Card}"
                    Visibility="Collapsed" Margin="0,0,0,12" Padding="6,8">
              <ListBox Style="{StaticResource VersionList}"
                       ItemContainerStyle="{StaticResource VersionItem}"
                       ItemTemplate="{StaticResource VersionRowTemplate}"
                       ItemsSource="{Binding JokeView}"
                       SelectedItem="{Binding SelectedVersion, Mode=TwoWay}"
                       MaxHeight="300"/>
            </Border>

            <TextBlock Text="{Binding VersionCountText}" FontSize="11.5"
                       Foreground="{StaticResource TextMutedBrush}" Margin="2,0,0,0"/>

            <!-- 筛选框 -->
            <Border Style="{StaticResource Card}" Margin="0,12,0,0">
              <Grid>
                <Grid.ColumnDefinitions>
                  <ColumnDefinition Width="Auto"/>
                  <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>
                <TextBlock Grid.Column="0" Text="筛选版本" FontSize="12.5"
                           Foreground="{StaticResource TextSoftBrush}"
                           VerticalAlignment="Center" Margin="0,0,12,0"/>
                <TextBox Grid.Column="1"
                         Text="{Binding VersionFilter, UpdateSourceTrigger=PropertyChanged}"
                         ToolTip="输入版本号筛选，例如 1.21"/>
              </Grid>
            </Border>

            <!-- 下载按钮 -->
            <Button Content="仅下载（不启动）" Style="{StaticResource FlatButton}"
                    IsEnabled="{Binding IsIdle}" Click="Install_Click"
                    HorizontalAlignment="Left" Margin="0,4,0,0"/>
          </StackPanel>
        </ScrollViewer>

        <!-- ════ 社区资源 ════
             下载页左栏那七项（Mod/整合包/数据包/资源包/光影包/世界/收藏夹）
             共用这一屏，靠左栏导航切栏目。 -->
        <Grid x:Name="PageContent" Visibility="Collapsed" DataContext="{Binding Content}">
          <Grid.Resources>
            <!-- 搜索结果和收藏项共用这一个行模板：它们都变成 ContentRow -->
            <DataTemplate x:Key="ContentRowTpl">
              <Border Style="{StaticResource CardRow}" Margin="0,0,0,6">
                <Grid>
                  <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                  </Grid.ColumnDefinitions>

                  <StackPanel Grid.Column="0" Margin="0,0,12,0">
                    <StackPanel Orientation="Horizontal">
                      <TextBlock Text="{Binding Title}" FontSize="13.5" FontWeight="SemiBold"
                                 Foreground="{StaticResource TextBrush}" TextTrimming="CharacterEllipsis"/>
                      <Border Background="{StaticResource SelectedBrush}" CornerRadius="3"
                              Padding="6,1,6,2" Margin="8,1,0,0" VerticalAlignment="Center">
                        <TextBlock Text="{Binding TypeText}" FontSize="10.5"
                                   Foreground="{StaticResource PrimaryLoBrush}"/>
                      </Border>
                    </StackPanel>
                    <TextBlock Text="{Binding SubtitleText}" FontSize="11.5" TextWrapping="Wrap"
                               Foreground="{StaticResource TextMutedBrush}" Margin="0,4,0,0"/>
                    <TextBlock Text="{Binding LoadersText}" FontSize="11"
                               Foreground="{StaticResource TextMutedBrush}" Margin="0,2,0,0"
                               Visibility="{Binding HasLoaderText, Converter={StaticResource BoolVis}}"/>
                  </StackPanel>

                  <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                    <Button Content="{Binding FavoriteButtonText}" Style="{StaticResource FlatButton}"
                            Padding="12,5" MinWidth="60" Tag="{Binding}" Click="ContentFav_Click"/>
                    <Button Content="安装" Style="{StaticResource PrimaryButton}"
                            Padding="16,5" MinWidth="60" Margin="8,0,0,0"
                            Tag="{Binding}" Click="ContentInstall_Click"/>
                  </StackPanel>
                </Grid>
              </Border>
            </DataTemplate>

            <!-- 世界列表的一行 -->
            <DataTemplate x:Key="WorldRowTpl">
              <Border Style="{StaticResource CardRow}" Margin="0,0,0,6">
                <Grid>
                  <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                  </Grid.ColumnDefinitions>

                  <StackPanel Grid.Column="0" Margin="0,0,12,0">
                    <TextBlock Text="{Binding Name}" FontSize="13.5" FontWeight="SemiBold"
                               Foreground="{StaticResource TextBrush}"/>
                    <TextBlock FontSize="11.5" Foreground="{StaticResource TextMutedBrush}" Margin="0,4,0,0">
                      <Run Text="{Binding SizeText}"/>
                      <Run Text="　·　"/>
                      <Run Text="{Binding LastWriteText}"/>
                    </TextBlock>
                    <TextBlock Text="{Binding Path}" FontSize="11" TextTrimming="CharacterEllipsis"
                               Foreground="{StaticResource TextMutedBrush}" Margin="0,2,0,0"/>
                  </StackPanel>

                  <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                    <Button Content="打开目录" Style="{StaticResource FlatButton}" Padding="12,5"
                            Tag="{Binding}" Click="WorldOpen_Click"/>
                    <Button Content="导出 zip" Style="{StaticResource FlatButton}" Padding="12,5" Margin="8,0,0,0"
                            Tag="{Binding}" Click="WorldExport_Click"/>
                    <Button Content="删除" Style="{StaticResource FlatButton}" Padding="12,5" Margin="8,0,0,0"
                            Tag="{Binding}" Click="WorldDelete_Click"/>
                  </StackPanel>
                </Grid>
              </Border>
            </DataTemplate>
          </Grid.Resources>

          <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
          </Grid.RowDefinitions>

          <!-- 标题 + 这一栏的说明 -->
          <StackPanel Grid.Row="0" Margin="22,18,22,0">
            <TextBlock Text="{Binding Title}" FontSize="17" FontWeight="SemiBold"
                       Foreground="{StaticResource TextBrush}"/>
            <TextBlock Text="{Binding HintText}" FontSize="12" TextWrapping="Wrap"
                       Foreground="{StaticResource TextMutedBrush}" Margin="0,6,0,0"/>
          </StackPanel>

          <!-- 搜索条：只有能联网搜的栏目才有 -->
          <Border Grid.Row="1" Style="{StaticResource Card}" Margin="22,14,22,0"
                  Visibility="{Binding ShowSearchPanel, Converter={StaticResource BoolVis}}">
            <StackPanel>
              <Grid>
                <Grid.ColumnDefinitions>
                  <ColumnDefinition Width="*"/>
                  <ColumnDefinition Width="Auto"/>
                  <ColumnDefinition Width="Auto"/>
                  <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <TextBox x:Name="ContentQueryBox" Grid.Column="0" Height="32"
                         VerticalContentAlignment="Center" Padding="8,0"
                         Text="{Binding SearchQuery, UpdateSourceTrigger=PropertyChanged}"/>

                <TextBox Grid.Column="1" Width="104" Height="32" Margin="8,0,0,0"
                         VerticalContentAlignment="Center" Padding="8,0"
                         Text="{Binding McVersion, UpdateSourceTrigger=PropertyChanged}"
                         ToolTip="按游戏版本过滤，留空表示不限"/>

                <TextBox Grid.Column="2" Width="104" Height="32" Margin="8,0,0,0"
                         VerticalContentAlignment="Center" Padding="8,0"
                         Text="{Binding Loader, UpdateSourceTrigger=PropertyChanged}"
                         ToolTip="加载器（fabric / forge / neoforge / quilt），留空表示不限"
                         Visibility="{Binding NeedsLoader, Converter={StaticResource BoolVis}}"/>

                <Button Grid.Column="3" Content="{Binding SearchButtonText}"
                        Style="{StaticResource PrimaryButton}" Margin="8,0,0,0"
                        Click="ContentSearch_Click" IsEnabled="{Binding CanSearch}"/>
              </Grid>

              <TextBlock Text="{Binding SearchFilterText}" FontSize="11.5"
                         Foreground="{StaticResource TextMutedBrush}" Margin="0,8,0,0"/>

              <!-- 数据包要选一个世界 -->
              <Grid Margin="0,10,0,0"
                    Visibility="{Binding NeedsWorldPick, Converter={StaticResource BoolVis}}">
                <Grid.ColumnDefinitions>
                  <ColumnDefinition Width="Auto"/>
                  <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>
                <TextBlock Grid.Column="0" Text="装到哪个世界" FontSize="12.5" VerticalAlignment="Center"
                           Foreground="{StaticResource TextSoftBrush}"/>
                <ComboBox Grid.Column="1" Margin="12,0,0,0" Height="30"
                          ItemsSource="{Binding Worlds}" DisplayMemberPath="Name"
                          SelectedValuePath="Name" SelectedValue="{Binding TargetWorld}"/>
              </Grid>
            </StackPanel>
          </Border>

          <!-- 世界栏的工具条 -->
          <Border Grid.Row="1" Style="{StaticResource Card}" Margin="22,14,22,0"
                  Visibility="{Binding ShowWorldPanel, Converter={StaticResource BoolVis}}">
            <StackPanel Orientation="Horizontal">
              <Button Content="导入存档 zip" Style="{StaticResource PrimaryButton}" Click="WorldImport_Click"/>
              <Button Content="打开存档目录" Style="{StaticResource FlatButton}" Margin="8,0,0,0"
                      Click="OpenContentFolder_Click"/>
              <TextBlock Text="{Binding InstanceText}" FontSize="11.5" VerticalAlignment="Center"
                         Foreground="{StaticResource TextMutedBrush}" Margin="14,0,0,0"/>
            </StackPanel>
          </Border>

          <!-- 状态行 -->
          <Border Grid.Row="2" Style="{StaticResource Card}" Padding="14,10" Margin="22,10,22,0"
                  Visibility="{Binding HasStatus, Converter={StaticResource BoolVis}}">
            <TextBlock Text="{Binding StatusMessage}" FontSize="12" TextWrapping="Wrap"
                       Foreground="{StaticResource TextSoftBrush}"/>
          </Border>

          <!-- 列表 -->
          <ScrollViewer Grid.Row="3" VerticalScrollBarVisibility="Auto" Padding="22,14,22,18">
            <Grid>
              <!-- 搜索结果 -->
              <ItemsControl ItemsSource="{Binding Results}" ItemTemplate="{StaticResource ContentRowTpl}"
                            Visibility="{Binding ShowSearchPanel, Converter={StaticResource BoolVis}}"/>

              <!-- 世界列表 -->
              <ItemsControl ItemsSource="{Binding Worlds}" ItemTemplate="{StaticResource WorldRowTpl}"
                            Visibility="{Binding ShowWorldPanel, Converter={StaticResource BoolVis}}"/>

              <!-- 收藏夹 -->
              <ItemsControl ItemsSource="{Binding Favorites}" ItemTemplate="{StaticResource ContentRowTpl}"
                            Visibility="{Binding ShowFavoritePanel, Converter={StaticResource BoolVis}}"/>
            </Grid>
          </ScrollViewer>
        </Grid>

        <!-- ════ 设置页 ════ -->
        <ScrollViewer x:Name="PageSettings" Visibility="Collapsed"
                      VerticalScrollBarVisibility="Auto" Padding="22,18,22,18">
          <!-- 五个分区叠在同一格里，靠左栏导航切换显示哪一个 -->
          <Grid>
            <!-- ── 游戏 → 启动 ── -->
            <StackPanel x:Name="SetSecLaunch">
            <!-- 启动选项 -->
            <Border Style="{StaticResource Card}">
              <StackPanel>
                <TextBlock Text="启动选项" FontSize="14" FontWeight="SemiBold"
                           Foreground="{StaticResource TextBrush}" Margin="0,0,0,14"/>

                <Grid Margin="0,0,0,5">
                  <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="118"/>
                    <ColumnDefinition Width="*"/>
                  </Grid.ColumnDefinitions>
                  <TextBlock Grid.Column="0" Text="默认版本隔离" FontSize="13"
                             Foreground="{StaticResource TextSoftBrush}" VerticalAlignment="Center"/>
                  <ComboBox Grid.Column="1" SelectedValuePath="Tag"
                            SelectedValue="{Binding Config.IsolateInstances, Mode=TwoWay}">
                    <ComboBoxItem Content="隔离所有实例" Tag="True"/>
                    <ComboBoxItem Content="不隔离" Tag="False"/>
                  </ComboBox>
                </Grid>

                <Grid Margin="0,0,0,5">
                  <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="118"/>
                    <ColumnDefinition Width="*"/>
                  </Grid.ColumnDefinitions>
                  <TextBlock Grid.Column="0" Text="游戏窗口标题" FontSize="13"
                             Foreground="{StaticResource TextSoftBrush}" VerticalAlignment="Center"/>
                  <TextBox Grid.Column="1" Text="默认"
                           ToolTip="留「默认」表示不覆盖版本自带的标题"/>
                </Grid>

                <Grid Margin="0,0,0,5">
                  <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="118"/>
                    <ColumnDefinition Width="*"/>
                  </Grid.ColumnDefinitions>
                  <TextBlock Grid.Column="0" Text="自定义信息" FontSize="13"
                             Foreground="{StaticResource TextSoftBrush}" VerticalAlignment="Center"/>
                  <TextBox Grid.Column="1" Text="{Binding CustomInfo, UpdateSourceTrigger=PropertyChanged}"/>
                </Grid>

                <Grid Margin="0,0,0,5">
                  <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="118"/>
                    <ColumnDefinition Width="*"/>
                  </Grid.ColumnDefinitions>
                  <TextBlock Grid.Column="0" Text="启动器可见性" FontSize="13"
                             Foreground="{StaticResource TextSoftBrush}" VerticalAlignment="Center"/>
                  <ComboBox Grid.Column="1" SelectedValuePath="Tag"
                            SelectedValue="{Binding Config.HideOnLaunch, Mode=TwoWay}">
                    <ComboBoxItem Content="游戏启动后仍保持不变" Tag="False"/>
                    <ComboBoxItem Content="游戏启动后隐藏启动器" Tag="True"/>
                  </ComboBox>
                </Grid>

                <Grid Margin="0,0,0,5">
                  <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="118"/>
                    <ColumnDefinition Width="*"/>
                  </Grid.ColumnDefinitions>
                  <TextBlock Grid.Column="0" Text="进程优先级" FontSize="13"
                             Foreground="{StaticResource TextSoftBrush}" VerticalAlignment="Center"/>
                  <ComboBox Grid.Column="1" SelectedValuePath="Tag"
                            SelectedValue="{Binding Config.ProcessPriority, Mode=TwoWay}">
                    <ComboBoxItem Content="高（优先保证游戏运行，游戏性能更佳，但可能造成其他程序卡顿）" Tag="high"/>
                    <ComboBoxItem Content="普通" Tag="normal"/>
                    <ComboBoxItem Content="低" Tag="low"/>
                  </ComboBox>
                </Grid>

                <Grid Margin="0,0,0,5">
                  <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="118"/>
                    <ColumnDefinition Width="*"/>
                  </Grid.ColumnDefinitions>
                  <TextBlock Grid.Column="0" Text="窗口大小" FontSize="13"
                             Foreground="{StaticResource TextSoftBrush}" VerticalAlignment="Center"/>
                  <ComboBox Grid.Column="1" SelectedValuePath="Tag"
                            SelectedValue="{Binding Config.WindowSize, Mode=TwoWay}">
                    <ComboBoxItem Content="默认" Tag="default"/>
                    <ComboBoxItem Content="最大化" Tag="maximized"/>
                  </ComboBox>
                </Grid>

                <Grid>
                  <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="118"/>
                    <ColumnDefinition Width="*"/>
                  </Grid.ColumnDefinitions>
                  <TextBlock Grid.Column="0" Text="正版验证方式" FontSize="13"
                             Foreground="{StaticResource TextSoftBrush}" VerticalAlignment="Center"/>
                  <ComboBox Grid.Column="1" SelectedValuePath="Tag"
                            SelectedValue="{Binding Config.AuthMode, Mode=TwoWay}">
                    <ComboBoxItem Content="设备代码流" Tag="devicecode"/>
                    <ComboBoxItem Content="浏览器跳转" Tag="browser"/>
                  </ComboBox>
                </Grid>
              </StackPanel>
            </Border>

            <!-- 账号 → 见「账号」分区 -->
            <!-- 游戏内存 -->
            <Border Style="{StaticResource Card}">
              <StackPanel>
                <TextBlock Text="游戏内存" FontSize="14" FontWeight="SemiBold"
                           Foreground="{StaticResource TextBrush}" Margin="0,0,0,12"/>

                <RadioButton Content="自动配置 / 自定义" GroupName="Mem" IsChecked="True"
                             FontSize="13" Foreground="{StaticResource TextSoftBrush}"
                             Margin="0,0,0,10"/>

                <!-- 内存滑杆。这里不再额外画一条内存条 —— 滑杆轨道本身就表示区间，
                     下面再叠一条填充会让人以为是两个不同的设置。 -->
                <Slider x:Name="MemorySlider" Style="{StaticResource NiceSlider}"
                        Minimum="1024" Maximum="16384" TickFrequency="512"
                        IsSnapToTickEnabled="True"
                        Value="{Binding MaxMemoryMb, Mode=TwoWay}"/>

                <!-- 内存占用条：系统已用 / 游戏分配 / 剩余。
                     三段宽度由 VM 换算成星值，加起来铺满整条。 -->
                <Border Height="8" CornerRadius="3" Margin="0,14,0,0"
                        Background="{StaticResource BgBrush}" ClipToBounds="True">
                  <Grid>
                    <Grid.ColumnDefinitions>
                      <ColumnDefinition Width="{Binding MemUsedStar}"/>
                      <ColumnDefinition Width="{Binding MemGameStar}"/>
                      <ColumnDefinition Width="{Binding MemFreeStar}"/>
                    </Grid.ColumnDefinitions>
                    <Border Grid.Column="0" Background="{StaticResource PrimaryHiBrush}"/>
                    <Border Grid.Column="1" Background="{StaticResource PrimaryBrush}"/>
                  </Grid>
                </Border>

                <Grid Margin="0,7,0,0">
                  <TextBlock x:Name="MemUsedCaption" Text="{Binding MemoryUsedLabel}"
                             FontSize="11.5" HorizontalAlignment="Left"
                             Foreground="{StaticResource TextMutedBrush}"/>
                  <TextBlock Text="{Binding MemoryTotalLabel}" FontSize="11.5"
                             HorizontalAlignment="Right"
                             Foreground="{StaticResource TextMutedBrush}"/>
                </Grid>

                <Grid Margin="0,8,0,0">
                  <TextBlock Text="{Binding MemoryUsedText}" FontSize="11.5"
                             Foreground="{StaticResource TextMutedBrush}"
                             TextTrimming="CharacterEllipsis"/>
                  <TextBlock Text="{Binding MemoryLabel}" FontSize="12"
                             FontWeight="SemiBold"
                             Foreground="{StaticResource PrimaryBrush}"
                             HorizontalAlignment="Right"/>
                </Grid>

                <!-- 底部胶囊按钮：设置当前实例的独立配置 -->
                <Button Content="实例独立设置" Style="{StaticResource PillButton}"
                        HorizontalAlignment="Center" Margin="0,18,0,2"
                        Click="InstanceSettings_Click"/>
              </StackPanel>
            </Border>

            <!-- 高级选项折叠 -->
            <ToggleButton x:Name="FoldAdvanced" Style="{StaticResource FoldHeader}"
                          Content="高级启动选项" Click="Fold_Click"/>
            <Border x:Name="PanelAdvanced" Style="{StaticResource Card}"
                    Visibility="Collapsed" Margin="0,8,0,0">
              <StackPanel>
                <Grid Margin="0,0,0,5">
                  <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="118"/>
                    <ColumnDefinition Width="*"/>
                  </Grid.ColumnDefinitions>
                  <TextBlock Grid.Column="0" Text="JVM 参数" FontSize="13"
                             Foreground="{StaticResource TextSoftBrush}" VerticalAlignment="Center"/>
                  <TextBox Grid.Column="1" Text="{Binding JvmArgs, UpdateSourceTrigger=PropertyChanged}"/>
                </Grid>
                <Grid>
                  <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="118"/>
                    <ColumnDefinition Width="*"/>
                  </Grid.ColumnDefinitions>
                  <TextBlock Grid.Column="0" Text="游戏目录" FontSize="13"
                             Foreground="{StaticResource TextSoftBrush}" VerticalAlignment="Center"/>
                  <TextBlock x:Name="GameRootText" Grid.Column="1" Text="{Binding GameRoot}" FontSize="12"
                             Foreground="{StaticResource TextMutedBrush}"
                             VerticalAlignment="Center" TextTrimming="CharacterEllipsis"/>
                </Grid>
              </StackPanel>
            </Border>
            </StackPanel><!-- /SetSecLaunch -->

            <!-- ── 游戏 → Java ── -->
            <StackPanel x:Name="SetSecJava" Visibility="Collapsed">
              <Border Style="{StaticResource Card}">
                <StackPanel>
                  <TextBlock Text="Java 运行时" FontSize="14" FontWeight="SemiBold"
                             Foreground="{StaticResource TextBrush}" Margin="0,0,0,6"/>
                  <TextBlock Text="启动器会自动探测本机的 Java。下面选中的那个会写进配置，启动时优先使用。"
                             FontSize="11.5" TextWrapping="Wrap" Margin="0,0,0,12"
                             Foreground="{StaticResource TextMutedBrush}"/>

                  <ComboBox ItemsSource="{Binding JavaList}"
                            SelectedItem="{Binding SelectedJava, Mode=TwoWay}"
                            MaxDropDownHeight="260">
                    <ComboBox.ItemTemplate>
                      <DataTemplate>
                        <Grid Margin="0,3">
                          <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                          </Grid.ColumnDefinitions>
                          <TextBlock Grid.Column="0" Text="{Binding VersionLabel}"
                                     FontSize="13" FontWeight="SemiBold"
                                     Foreground="{StaticResource TextBrush}"/>
                          <TextBlock Grid.Column="1" Text="{Binding VendorLabel}"
                                     FontSize="12" Margin="10,0,0,0"
                                     VerticalAlignment="Center"
                                     Foreground="{StaticResource TextMutedBrush}"/>
                        </Grid>
                      </DataTemplate>
                    </ComboBox.ItemTemplate>
                  </ComboBox>

                  <StackPanel Orientation="Horizontal" Margin="0,14,0,0">
                    <Button Content="重新探测" Style="{StaticResource FlatButton}"
                            Click="RescanJava_Click" Margin="0,0,8,0"/>
                    <Button Content="手动指定 java.exe…" Style="{StaticResource FlatButton}"
                            Click="PickJava_Click" Margin="0,0,8,0"/>
                    <Button Content="自动下载 JRE" Style="{StaticResource FlatButton}"
                            Click="DownloadJava_Click"/>
                  </StackPanel>
                </StackPanel>
              </Border>

              <Border Style="{StaticResource Card}">
                <StackPanel>
                  <TextBlock Text="当前选用" FontSize="14" FontWeight="SemiBold"
                             Foreground="{StaticResource TextBrush}" Margin="0,0,0,12"/>
                  <Grid>
                    <Grid.ColumnDefinitions>
                      <ColumnDefinition Width="118"/>
                      <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    <TextBlock Grid.Column="0" Text="版本" FontSize="13"
                               Foreground="{StaticResource TextSoftBrush}" VerticalAlignment="Center"/>
                    <TextBlock Grid.Column="1" Text="{Binding JavaSummary}" FontSize="13"
                               Foreground="{StaticResource TextBrush}"
                               VerticalAlignment="Center"/>
                  </Grid>
                  <Grid Margin="0,10,0,0">
                    <Grid.ColumnDefinitions>
                      <ColumnDefinition Width="118"/>
                      <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    <TextBlock Grid.Column="0" Text="路径" FontSize="13"
                               Foreground="{StaticResource TextSoftBrush}" VerticalAlignment="Center"/>
                    <TextBlock Grid.Column="1" Text="{Binding SelectedJava.Path}" FontSize="12"
                               Foreground="{StaticResource TextMutedBrush}"
                               TextWrapping="Wrap"/>
                  </Grid>
                </StackPanel>
              </Border>
            </StackPanel><!-- /SetSecJava -->

            <!-- ── 游戏 → 账号 ── -->
            <StackPanel x:Name="SetSecAccount" Visibility="Collapsed">
              <Border Style="{StaticResource Card}">
                <StackPanel>
                  <TextBlock Text="账号" FontSize="14" FontWeight="SemiBold"
                             Foreground="{StaticResource TextBrush}" Margin="0,0,0,12"/>

                  <Grid>
                    <Grid.ColumnDefinitions>
                      <ColumnDefinition Width="118"/>
                      <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    <TextBlock Grid.Column="0" Text="玩家名" FontSize="13"
                               Foreground="{StaticResource TextSoftBrush}" VerticalAlignment="Center"/>
                    <TextBox x:Name="UsernameBox" Grid.Column="1"
                             Text="{Binding Username, UpdateSourceTrigger=PropertyChanged}"/>
                  </Grid>

                  <Grid Margin="0,12,0,0">
                    <Grid.ColumnDefinitions>
                      <ColumnDefinition Width="118"/>
                      <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    <TextBlock Grid.Column="0" Text="当前账号" FontSize="13"
                               Foreground="{StaticResource TextSoftBrush}" VerticalAlignment="Center"/>
                    <StackPanel Grid.Column="1" Orientation="Horizontal">
                      <Border Width="26" Height="26" CornerRadius="13"
                              Background="{StaticResource PrimaryHiBrush}" VerticalAlignment="Center">
                        <TextBlock Text="{Binding AccountInitial}" FontSize="12" FontWeight="Bold"
                                   Foreground="White" HorizontalAlignment="Center"
                                   VerticalAlignment="Center"/>
                      </Border>
                      <TextBlock Text="{Binding AccountLabel}" FontSize="13" Margin="10,0,0,0"
                                 VerticalAlignment="Center"
                                 Foreground="{StaticResource TextBrush}"/>
                      <Button Content="切换账号 / 正版登录" Style="{StaticResource FlatButton}"
                              Click="Account_Click" Margin="14,0,0,0" Padding="12,5"/>
                    </StackPanel>
                  </Grid>

                  <TextBlock Text="玩家名只用于离线模式；用正版账号登录后，进服务器认的是正版 UUID，名字不再生效。"
                             FontSize="11.5" TextWrapping="Wrap" Margin="118,12,0,0"
                             Foreground="{StaticResource TextMutedBrush}"/>
                </StackPanel>
              </Border>
            </StackPanel><!-- /SetSecAccount -->

            <!-- ── 启动器 → 个性化 ── -->
            <StackPanel x:Name="SetSecAppearance" Visibility="Collapsed">
              <Border Style="{StaticResource Card}">
                <StackPanel>
                  <TextBlock Text="界面" FontSize="14" FontWeight="SemiBold"
                             Foreground="{StaticResource TextBrush}" Margin="0,0,0,12"/>

                  <Grid Margin="0,0,0,5">
                    <Grid.ColumnDefinitions>
                      <ColumnDefinition Width="118"/>
                      <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    <TextBlock Grid.Column="0" Text="默认页签" FontSize="13"
                               Foreground="{StaticResource TextSoftBrush}" VerticalAlignment="Center"/>
                    <ComboBox Grid.Column="1" SelectedValuePath="Tag"
                              SelectedValue="{Binding Config.DefaultTab, Mode=TwoWay}">
                      <ComboBoxItem Content="启动" Tag="launch"/>
                      <ComboBoxItem Content="下载" Tag="download"/>
                      <ComboBoxItem Content="设置" Tag="settings"/>
                      <ComboBoxItem Content="工具" Tag="tools"/>
                    </ComboBox>
                  </Grid>

                  <Grid Margin="0,0,0,5">
                    <Grid.ColumnDefinitions>
                      <ColumnDefinition Width="118"/>
                      <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    <TextBlock Grid.Column="0" Text="启动时展开日志" FontSize="13"
                               Foreground="{StaticResource TextSoftBrush}" VerticalAlignment="Center"/>
                    <ComboBox Grid.Column="1" SelectedValuePath="Tag"
                              SelectedValue="{Binding Config.AutoExpandLog, Mode=TwoWay}">
                      <ComboBoxItem Content="不展开" Tag="False"/>
                      <ComboBoxItem Content="自动展开底部日志抽屉" Tag="True"/>
                    </ComboBox>
                  </Grid>

                  <TextBlock Text="主题色、背景图这类外观项还没做，所以这里不摆无效的开关。"
                             FontSize="11.5" TextWrapping="Wrap" Margin="118,10,0,0"
                             Foreground="{StaticResource TextMutedBrush}"/>
                </StackPanel>
              </Border>
            </StackPanel><!-- /SetSecAppearance -->

            <!-- ── 启动器 → 杂项 ── -->
            <StackPanel x:Name="SetSecMisc" Visibility="Collapsed">
              <Border Style="{StaticResource Card}">
                <StackPanel>
                  <TextBlock Text="行为" FontSize="14" FontWeight="SemiBold"
                             Foreground="{StaticResource TextBrush}" Margin="0,0,0,12"/>

                  <Grid Margin="0,0,0,5">
                    <Grid.ColumnDefinitions>
                      <ColumnDefinition Width="118"/>
                      <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    <TextBlock Grid.Column="0" Text="启动前补全文件" FontSize="13"
                               Foreground="{StaticResource TextSoftBrush}" VerticalAlignment="Center"/>
                    <ComboBox Grid.Column="1" SelectedValuePath="Tag"
                              SelectedValue="{Binding Config.AutoInstall, Mode=TwoWay}">
                      <ComboBoxItem Content="自动检查并补齐缺失文件" Tag="True"/>
                      <ComboBoxItem Content="不检查（自己保证文件完整）" Tag="False"/>
                    </ComboBox>
                  </Grid>

                  <Grid>
                    <Grid.ColumnDefinitions>
                      <ColumnDefinition Width="118"/>
                      <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    <TextBlock Grid.Column="0" Text="关闭启动器时" FontSize="13"
                               Foreground="{StaticResource TextSoftBrush}" VerticalAlignment="Center"/>
                    <ComboBox Grid.Column="1" SelectedValuePath="Tag"
                              SelectedValue="{Binding Config.KillGameOnExit, Mode=TwoWay}">
                      <ComboBoxItem Content="同时结束游戏进程" Tag="True"/>
                      <ComboBoxItem Content="让游戏继续跑" Tag="False"/>
                    </ComboBox>
                  </Grid>
                </StackPanel>
              </Border>

              <Border Style="{StaticResource Card}">
                <StackPanel>
                  <TextBlock Text="游戏目录" FontSize="14" FontWeight="SemiBold"
                             Foreground="{StaticResource TextBrush}" Margin="0,0,0,12"/>
                  <TextBlock Text="{Binding GameRoot}" FontSize="12" TextWrapping="Wrap"
                             Foreground="{StaticResource TextMutedBrush}"/>
                  <StackPanel Orientation="Horizontal" Margin="0,12,0,0">
                    <Button Content="打开目录" Style="{StaticResource FlatButton}"
                            Click="OpenFolder_Click" Margin="0,0,8,0"/>
                    <Button Content="复制路径" Style="{StaticResource FlatButton}"
                            Click="CopyRoot_Click"/>
                  </StackPanel>
                </StackPanel>
              </Border>
            </StackPanel><!-- /SetSecMisc -->
          </Grid>
        </ScrollViewer>

        <!-- ════ 工具页 ════ -->
        <ScrollViewer x:Name="PageTools" Visibility="Collapsed"
                      VerticalScrollBarVisibility="Auto" Padding="22,18,22,18">
          <Grid>
            <!-- ── 联机 → 大厅 ── -->
            <StackPanel x:Name="ToolSecLobby">

              <!-- 先把「这里没有官方服务器」说清楚。不解释清楚，用户会一直等一个
                   永远不会出现的编号，那才是真正的坑。 -->
              <Border Background="#E8F2FE" BorderBrush="#C6DEF8" BorderThickness="1"
                      CornerRadius="6" Padding="16,12" Margin="0,0,0,12">
                <TextBlock FontSize="12.5" Foreground="{StaticResource PrimaryLoBrush}"
                           TextWrapping="Wrap"
                           Text="[说明] 这里没有官方中继服务器，也不需要它：局域网世界走游戏自带的广播发现；大厅编号本身就是把地址和端口编码后的结果，不经过任何第三方。所以下面的功能不会因为某个服务下线而失效。"/>
              </Border>

              <!-- 状态行：上一次动作的结果。没动作时整行不出现。 -->
              <Border Background="#F2F7FE" BorderBrush="#D6E6FA" BorderThickness="1"
                      CornerRadius="6" Padding="14,10" Margin="0,0,0,12"
                      Visibility="{Binding Lobby.HasStatus, Converter={StaticResource BoolVis}}">
                <TextBlock Text="{Binding Lobby.Status}" FontSize="12.5"
                           Foreground="{StaticResource PrimaryLoBrush}" TextWrapping="Wrap"/>
              </Border>

              <!-- 局域网世界 -->
              <Border Style="{StaticResource Card}">
                <StackPanel>
                  <Grid Margin="0,0,0,8">
                    <Grid.ColumnDefinitions>
                      <ColumnDefinition Width="*"/>
                      <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <TextBlock Grid.Column="0" Text="局域网世界" FontSize="14" FontWeight="SemiBold"
                               Foreground="{StaticResource TextBrush}" VerticalAlignment="Center"/>
                    <Button Grid.Column="1" Content="{Binding Lobby.ScanButtonText}"
                            Style="{StaticResource FlatButton}" Padding="14,6"
                            IsEnabled="{Binding Lobby.IsScanning, Converter={StaticResource InvBool}}"
                            Click="ScanLan_Click"/>
                  </Grid>

                  <TextBlock FontSize="12.5" Foreground="{StaticResource TextSoftBrush}"
                             TextWrapping="Wrap" Margin="0,0,0,8"
                             Text="同一个局域网里，只要有人在游戏里选了「对局域网开放」，这里就能直接看到他。"/>

                  <TextBlock Text="{Binding Lobby.ScanNote}" FontSize="12.5"
                             Foreground="{StaticResource TextMutedBrush}" TextWrapping="Wrap"
                             Visibility="{Binding Lobby.HasScanNote, Converter={StaticResource BoolVis}}"/>

                  <ItemsControl ItemsSource="{Binding Lobby.Worlds}" Margin="0,6,0,0">
                    <ItemsControl.ItemTemplate>
                      <DataTemplate>
                        <Grid Margin="0,0,0,6">
                          <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                          </Grid.ColumnDefinitions>
                          <StackPanel Grid.Column="0" VerticalAlignment="Center">
                            <TextBlock Text="{Binding Motd}" FontSize="13"
                                       Foreground="{StaticResource TextBrush}"
                                       TextTrimming="CharacterEllipsis"/>
                            <TextBlock Text="{Binding DetailText}" FontSize="11.5"
                                       FontFamily="{StaticResource MonoFont}"
                                       Foreground="{StaticResource TextMutedBrush}"/>
                          </StackPanel>
                          <Button Grid.Column="1" Content="加入列表" Style="{StaticResource FlatButton}"
                                  Padding="14,6" Tag="{Binding}" Click="AddLanWorld_Click"/>
                        </Grid>
                      </DataTemplate>
                    </ItemsControl.ItemTemplate>
                  </ItemsControl>
                </StackPanel>
              </Border>

              <!-- 加入大厅 -->
              <Border Style="{StaticResource Card}">
                <StackPanel>
                  <TextBlock Text="加入大厅" FontSize="14" FontWeight="SemiBold"
                             Foreground="{StaticResource TextBrush}" Margin="0,0,0,10"/>
                  <TextBlock Text="1、把朋友发来的大厅编号填进下面这一栏。"
                             FontSize="12.5" Foreground="{StaticResource TextSoftBrush}" Margin="0,0,0,4"/>
                  <TextBlock Text="2、点【加入】—— 编号会被写进这个实例的服务器列表，进游戏选【多人游戏】就能看到它。"
                             FontSize="12.5" Foreground="{StaticResource TextSoftBrush}"
                             TextWrapping="Wrap" Margin="0,0,0,12"/>

                  <Grid>
                    <Grid.ColumnDefinitions>
                      <ColumnDefinition Width="*"/>
                      <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <TextBox Grid.Column="0" Margin="0,0,8,0" FontFamily="{StaticResource MonoFont}"
                             ToolTip="编号应该长得像这样：60N0-0GMR-YXK"
                             Text="{Binding Lobby.JoinCode, UpdateSourceTrigger=PropertyChanged}"/>
                    <StackPanel Grid.Column="1" Orientation="Horizontal">
                      <Button Content="清除" Style="{StaticResource FlatButton}" Padding="14,6"
                              Margin="0,0,6,0" Click="ClearLobbyCode_Click"/>
                      <Button Content="粘贴" Style="{StaticResource FlatButton}" Padding="14,6"
                              Margin="0,0,6,0" Click="PasteLobbyCode_Click"/>
                      <Button Content="加入" Style="{StaticResource PrimaryButton}" Padding="18,6"
                              IsEnabled="{Binding Lobby.CanJoin}" Click="JoinLobby_Click"/>
                    </StackPanel>
                  </Grid>

                  <!-- 一边打字一边解码。编号长得都差不多，用户需要马上看到它指向哪儿。 -->
                  <TextBlock Text="{Binding Lobby.JoinPreview}" FontSize="12"
                             FontFamily="{StaticResource MonoFont}" TextWrapping="Wrap"
                             Foreground="{StaticResource TextMutedBrush}" Margin="0,8,0,0"/>
                </StackPanel>
              </Border>

              <!-- 创建大厅 -->
              <Border Style="{StaticResource Card}">
                <StackPanel>
                  <TextBlock Text="创建大厅" FontSize="14" FontWeight="SemiBold"
                             Foreground="{StaticResource TextBrush}" Margin="0,0,0,10"/>
                  <TextBlock Text="1、进游戏，在「对局域网开放」里选好端口（默认 25565）。"
                             FontSize="12.5" Foreground="{StaticResource TextSoftBrush}" Margin="0,0,0,4"/>
                  <TextBlock Text="2、在下面选本机的地址、填对端口，点【生成编号】。"
                             FontSize="12.5" Foreground="{StaticResource TextSoftBrush}" Margin="0,0,0,4"/>
                  <TextBlock Text="3、把编号发给朋友，他照上面的「加入大厅」做就行。"
                             FontSize="12.5" Foreground="{StaticResource TextSoftBrush}" Margin="0,0,0,12"/>

                  <Grid Margin="0,0,0,8">
                    <Grid.ColumnDefinitions>
                      <ColumnDefinition Width="*"/>
                      <ColumnDefinition Width="Auto"/>
                      <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <ComboBox Grid.Column="0" Margin="0,0,8,0"
                              ItemsSource="{Binding Lobby.LocalAddresses}"
                              SelectedItem="{Binding Lobby.SelectedAddress}"/>
                    <TextBox Grid.Column="1" Width="90" Margin="0,0,8,0"
                             FontFamily="{StaticResource MonoFont}"
                             Text="{Binding Lobby.PortText, UpdateSourceTrigger=PropertyChanged}"/>
                    <StackPanel Grid.Column="2" Orientation="Horizontal">
                      <Button Content="重新检测" Style="{StaticResource FlatButton}" Padding="14,6"
                              Margin="0,0,6,0" Click="RefreshLocalIp_Click"/>
                      <Button Content="生成编号" Style="{StaticResource PrimaryButton}" Padding="18,6"
                              IsEnabled="{Binding Lobby.CanCreateCode}" Click="CreateLobbyCode_Click"/>
                    </StackPanel>
                  </Grid>

                  <TextBlock Text="{Binding Lobby.PortHint}" FontSize="12"
                             Foreground="{StaticResource TextMutedBrush}" TextWrapping="Wrap"/>

                  <!-- 生成出来的编号 -->
                  <Border Visibility="{Binding Lobby.HasCreatedCode, Converter={StaticResource BoolVis}}"
                          Background="#F0F7EE" BorderBrush="#CFE8C8" BorderThickness="1"
                          CornerRadius="6" Padding="14,12" Margin="0,10,0,0">
                    <StackPanel>
                      <TextBlock Text="把这个编号发给朋友" FontSize="12.5"
                                 Foreground="{StaticResource TextSoftBrush}" Margin="0,0,0,6"/>
                      <TextBlock Text="{Binding Lobby.CreatedCode}" FontSize="20" FontWeight="SemiBold"
                                 FontFamily="{StaticResource MonoFont}"
                                 Foreground="{StaticResource SuccessBrush}" Margin="0,0,0,8"/>
                      <TextBlock Text="{Binding Lobby.CreatedHint}" FontSize="12"
                                 Foreground="{StaticResource TextSoftBrush}" TextWrapping="Wrap"
                                 Margin="0,0,0,10"/>
                      <StackPanel Orientation="Horizontal">
                        <Button Content="复制编号" Style="{StaticResource FlatButton}" Padding="14,6"
                                Margin="0,0,6,0" Click="CopyCreatedCode_Click"/>
                        <Button Content="复制地址" Style="{StaticResource FlatButton}" Padding="14,6"
                                Click="CopyCreatedAddress_Click"/>
                      </StackPanel>
                    </StackPanel>
                  </Border>
                </StackPanel>
              </Border>

              <!-- 服务器列表：就是游戏自己那份 servers.dat -->
              <Border Style="{StaticResource Card}">
                <StackPanel>
                  <Grid Margin="0,0,0,8">
                    <Grid.ColumnDefinitions>
                      <ColumnDefinition Width="*"/>
                      <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <TextBlock Grid.Column="0" Text="服务器列表" FontSize="14" FontWeight="SemiBold"
                               Foreground="{StaticResource TextBrush}" VerticalAlignment="Center"/>
                    <Button Grid.Column="1" Content="刷新" Style="{StaticResource FlatButton}"
                            Padding="14,6" Click="RefreshServers_Click"/>
                  </Grid>

                  <TextBlock Text="{Binding Lobby.ServersPath}" FontSize="11.5"
                             FontFamily="{StaticResource MonoFont}"
                             Foreground="{StaticResource TextMutedBrush}"
                             TextTrimming="CharacterEllipsis" Margin="0,0,0,8"/>

                  <TextBlock Text="{Binding Lobby.ServersEmptyText}" FontSize="12.5"
                             Foreground="{StaticResource TextMutedBrush}" TextWrapping="Wrap"/>

                  <ItemsControl ItemsSource="{Binding Lobby.Servers}">
                    <ItemsControl.ItemTemplate>
                      <DataTemplate>
                        <Grid Margin="0,0,0,6">
                          <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                          </Grid.ColumnDefinitions>
                          <StackPanel Grid.Column="0" VerticalAlignment="Center">
                            <TextBlock Text="{Binding Name}" FontSize="13"
                                       Foreground="{StaticResource TextBrush}"
                                       TextTrimming="CharacterEllipsis"/>
                            <TextBlock Text="{Binding Ip}" FontSize="11.5"
                                       FontFamily="{StaticResource MonoFont}"
                                       Foreground="{StaticResource TextMutedBrush}"/>
                          </StackPanel>
                          <Button Grid.Column="1" Content="移除" Style="{StaticResource FlatButton}"
                                  Padding="14,6" Tag="{Binding}" Click="RemoveServer_Click"/>
                        </Grid>
                      </DataTemplate>
                    </ItemsControl.ItemTemplate>
                  </ItemsControl>
                </StackPanel>
              </Border>

            </StackPanel><!-- /ToolSecLobby -->

            <!-- ── 奇妙小工具 → 百宝箱 ── -->
            <StackPanel x:Name="ToolSecBox" Visibility="Collapsed">

              <!-- 上一次动作的结果。没动作时整行不出现。 -->
              <Border Background="#EEF7EE" BorderBrush="#CFE6CF" BorderThickness="1"
                      CornerRadius="6" Padding="14,10" Margin="0,0,0,12"
                      Visibility="{Binding HasToolStatus, Converter={StaticResource BoolVis}}">
                <TextBlock Text="{Binding ToolStatus}" FontSize="12.5" TextWrapping="Wrap"
                           Foreground="#2F6B2F"/>
              </Border>

              <!-- 体检：这个实例到底占了多少，以及占在哪儿 -->
              <Border Style="{StaticResource Card}" Margin="0">
                <StackPanel>
                  <Grid Margin="0,0,0,4">
                    <StackPanel>
                      <TextBlock Text="目录体检" FontSize="14" FontWeight="SemiBold"
                                 Foreground="{StaticResource TextBrush}"/>
                      <TextBlock Text="{Binding ToolSummaryText}" FontSize="12"
                                 Foreground="{StaticResource TextMutedBrush}" Margin="0,4,0,0"/>
                    </StackPanel>
                    <Button Content="刷新" Style="{StaticResource FlatButton}" Padding="14,6"
                            HorizontalAlignment="Right" VerticalAlignment="Top"
                            Click="RefreshSurvey_Click"/>
                  </Grid>

                  <TextBlock Text="{Binding ToolDirLabel}" FontSize="11.5" TextWrapping="Wrap"
                             Foreground="{StaticResource TextMutedBrush}" Margin="0,0,0,2"/>

                  <ItemsControl ItemsSource="{Binding ToolUsages}" Margin="0,8,0,0">
                    <ItemsControl.ItemTemplate>
                      <DataTemplate>
                        <Grid Margin="0,0,0,4">
                          <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="110"/>
                            <ColumnDefinition Width="*"/>
                          </Grid.ColumnDefinitions>
                          <TextBlock Grid.Column="0" Text="{Binding Label}" FontSize="12.5"
                                     Foreground="{StaticResource TextSoftBrush}"/>
                          <TextBlock Grid.Column="1" Text="{Binding DisplayText}" FontSize="12.5"
                                     Foreground="{StaticResource TextMutedBrush}"/>
                        </Grid>
                      </DataTemplate>
                    </ItemsControl.ItemTemplate>
                  </ItemsControl>
                </StackPanel>
              </Border>

              <Border Style="{StaticResource Card}">
                <Grid>
                  <StackPanel>
                    <TextBlock Text="Mod 管理" FontSize="14" FontWeight="SemiBold"
                               Foreground="{StaticResource TextBrush}"/>
                    <TextBlock Text="给当前实例装 Mod、查依赖、搜索下载。"
                               FontSize="12" Foreground="{StaticResource TextMutedBrush}"
                               Margin="0,4,0,0"/>
                  </StackPanel>
                  <Button Content="打开" Style="{StaticResource FlatButton}" Padding="14,6"
                          HorizontalAlignment="Right" VerticalAlignment="Center"
                          Click="Mods_Click"/>
                </Grid>
              </Border>

              <Border Style="{StaticResource Card}">
                <Grid>
                  <StackPanel>
                    <TextBlock Text="校验并补全游戏文件" FontSize="14" FontWeight="SemiBold"
                               Foreground="{StaticResource TextBrush}"/>
                    <TextBlock Text="比对每个文件的大小与校验值，缺哪个下哪个 —— 比整个删掉重装稳妥。"
                               FontSize="12" Foreground="{StaticResource TextMutedBrush}"
                               Margin="0,4,0,0" TextWrapping="Wrap"/>
                  </StackPanel>
                  <Button Content="开始校验" Style="{StaticResource FlatButton}" Padding="14,6"
                          HorizontalAlignment="Right" VerticalAlignment="Center"
                          Click="Install_Click"/>
                </Grid>
              </Border>

              <Border Style="{StaticResource Card}">
                <Grid>
                  <StackPanel>
                    <TextBlock Text="存档" FontSize="14" FontWeight="SemiBold"
                               Foreground="{StaticResource TextBrush}"/>
                    <TextBlock Text="{Binding ToolWorldText}" FontSize="12"
                               Foreground="{StaticResource TextMutedBrush}" Margin="0,4,0,0"/>
                  </StackPanel>
                  <StackPanel Orientation="Horizontal" HorizontalAlignment="Right"
                              VerticalAlignment="Center">
                    <Button Content="管理" Style="{StaticResource FlatButton}" Padding="14,6"
                            Margin="0,0,8,0" Click="ManageWorlds_Click"/>
                    <Button Content="打开目录" Style="{StaticResource FlatButton}" Padding="14,6"
                            Tag="saves" Click="OpenTool_Click"/>
                  </StackPanel>
                </Grid>
              </Border>

              <Border Style="{StaticResource Card}">
                <Grid>
                  <StackPanel>
                    <TextBlock Text="截图" FontSize="14" FontWeight="SemiBold"
                               Foreground="{StaticResource TextBrush}"/>
                    <TextBlock Text="{Binding ToolScreenshotText}" FontSize="12"
                               Foreground="{StaticResource TextMutedBrush}" Margin="0,4,0,0"/>
                  </StackPanel>
                  <Button Content="打开目录" Style="{StaticResource FlatButton}" Padding="14,6"
                          HorizontalAlignment="Right" VerticalAlignment="Center"
                          Tag="screenshots" Click="OpenTool_Click"/>
                </Grid>
              </Border>

              <Border Style="{StaticResource Card}">
                <Grid>
                  <StackPanel>
                    <TextBlock Text="崩溃报告" FontSize="14" FontWeight="SemiBold"
                               Foreground="{StaticResource TextBrush}"/>
                    <TextBlock Text="{Binding ToolCrashText}" FontSize="12"
                               Foreground="{StaticResource TextMutedBrush}" Margin="0,4,0,0"/>
                  </StackPanel>
                  <StackPanel Orientation="Horizontal" HorizontalAlignment="Right"
                              VerticalAlignment="Center">
                    <Button Content="打开最新" Style="{StaticResource FlatButton}" Padding="14,6"
                            Margin="0,0,8,0" Click="OpenLatestCrash_Click"/>
                    <Button Content="打开目录" Style="{StaticResource FlatButton}" Padding="14,6"
                            Tag="crash-reports" Click="OpenTool_Click"/>
                  </StackPanel>
                </Grid>
              </Border>

              <Border Style="{StaticResource Card}">
                <Grid>
                  <StackPanel>
                    <TextBlock Text="清理垃圾" FontSize="14" FontWeight="SemiBold"
                               Foreground="{StaticResource TextBrush}"/>
                    <TextBlock Text="只清轮转过的日志、过期崩溃报告和下载残留。存档、Mod、配置一律不动。"
                               FontSize="12" Foreground="{StaticResource TextMutedBrush}"
                               Margin="0,4,0,0" TextWrapping="Wrap"/>
                  </StackPanel>
                  <Button Content="扫描并清理" Style="{StaticResource FlatButton}" Padding="14,6"
                          HorizontalAlignment="Right" VerticalAlignment="Center"
                          Click="CleanJunk_Click"/>
                </Grid>
              </Border>

              <Border Style="{StaticResource Card}">
                <Grid>
                  <StackPanel>
                    <TextBlock Text="复制启动命令" FontSize="14" FontWeight="SemiBold"
                               Foreground="{StaticResource TextBrush}"/>
                    <TextBlock Text="最近一次真正执行的命令行（取自启动日志首行，不是重新拼的）。"
                               FontSize="12" Foreground="{StaticResource TextMutedBrush}"
                               Margin="0,4,0,0" TextWrapping="Wrap"/>
                  </StackPanel>
                  <Button Content="复制" Style="{StaticResource FlatButton}" Padding="14,6"
                          HorizontalAlignment="Right" VerticalAlignment="Center"
                          Click="CopyLaunchCommand_Click"/>
                </Grid>
              </Border>

              <Border Style="{StaticResource Card}">
                <Grid>
                  <StackPanel>
                    <TextBlock Text="复制诊断信息" FontSize="14" FontWeight="SemiBold"
                               Foreground="{StaticResource TextBrush}"/>
                    <TextBlock Text="环境 + Java + 目录体积 + 日志尾巴，一次复制走，求助时直接贴。"
                               FontSize="12" Foreground="{StaticResource TextMutedBrush}"
                               Margin="0,4,0,0" TextWrapping="Wrap"/>
                  </StackPanel>
                  <Button Content="复制" Style="{StaticResource FlatButton}" Padding="14,6"
                          HorizontalAlignment="Right" VerticalAlignment="Center"
                          Click="CopyDiagnostics_Click"/>
                </Grid>
              </Border>

              <Border Style="{StaticResource Card}">
                <Grid>
                  <StackPanel>
                    <TextBlock Text="游戏目录" FontSize="14" FontWeight="SemiBold"
                               Foreground="{StaticResource TextBrush}"/>
                    <TextBlock Text="{Binding GameRoot}" FontSize="12" TextWrapping="Wrap"
                               Foreground="{StaticResource TextMutedBrush}" Margin="0,4,0,0"/>
                  </StackPanel>
                  <Button Content="打开" Style="{StaticResource FlatButton}" Padding="14,6"
                          HorizontalAlignment="Right" VerticalAlignment="Center"
                          Click="OpenFolder_Click"/>
                </Grid>
              </Border>

              <Border Style="{StaticResource Card}">
                <Grid>
                  <StackPanel>
                    <TextBlock Text="启动器日志" FontSize="14" FontWeight="SemiBold"
                               Foreground="{StaticResource TextBrush}"/>
                    <TextBlock Text="把底部的日志抽屉清干净，长日志关了再开。" FontSize="12"
                               Foreground="{StaticResource TextMutedBrush}" Margin="0,4,0,0"/>
                  </StackPanel>
                  <StackPanel Orientation="Horizontal" HorizontalAlignment="Right"
                              VerticalAlignment="Center">
                    <Button Content="展开" Style="{StaticResource FlatButton}" Padding="14,6"
                            Click="ShowLog_Click" Margin="0,0,8,0"/>
                    <Button Content="清空" Style="{StaticResource FlatButton}" Padding="14,6"
                            Click="ClearLog_Click"/>
                  </StackPanel>
                </Grid>
              </Border>
            </StackPanel><!-- /ToolSecBox -->

            <!-- ── 奇妙小工具 → 帮助库 ── -->
            <StackPanel x:Name="ToolSecHelp" Visibility="Collapsed">
              <Border Style="{StaticResource Card}" Margin="0">
                <StackPanel>
                  <TextBlock Text="常见问题" FontSize="14" FontWeight="SemiBold"
                             Foreground="{StaticResource TextBrush}" Margin="0,0,0,10"/>

                  <TextBlock Text="启动即崩 / 报 Unsupported class file major version" FontSize="12.5"
                             FontWeight="SemiBold" Foreground="{StaticResource TextSoftBrush}"/>
                  <TextBlock Text="Java 大版本不对。1.16 及以前要 Java 8，1.17~1.20.4 要 Java 17，1.20.5 起要 Java 21。到「设置 → Java」里换一个，或者点「自动下载 JRE」。"
                             FontSize="11.5" TextWrapping="Wrap" Margin="0,3,0,12"
                             Foreground="{StaticResource TextMutedBrush}"/>

                  <TextBlock Text="提示找不到 Java" FontSize="12.5"
                             FontWeight="SemiBold" Foreground="{StaticResource TextSoftBrush}"/>
                  <TextBlock Text="装一个 JDK/JRE 后在「设置 → Java」点「重新探测」，或者手动指定 java.exe 的路径。"
                             FontSize="11.5" TextWrapping="Wrap" Margin="0,3,0,12"
                             Foreground="{StaticResource TextMutedBrush}"/>

                  <TextBlock Text="Mod 装了没生效" FontSize="12.5"
                             FontWeight="SemiBold" Foreground="{StaticResource TextSoftBrush}"/>
                  <TextBlock Text="多半是版本不对：Mod 的 Minecraft 版本和加载器得跟实例一致。到「Mod 管理」里看依赖检查的结果，缺前置它会说。"
                             FontSize="11.5" TextWrapping="Wrap" Margin="0,3,0,12"
                             Foreground="{StaticResource TextMutedBrush}"/>

                  <TextBlock Text="游戏日志在哪" FontSize="12.5"
                             FontWeight="SemiBold" Foreground="{StaticResource TextSoftBrush}"/>
                  <TextBlock Text="按实例隔离，日志在 实例目录\logs\latest.log。底部那个抽屉只是启动器自己的输出。"
                             FontSize="11.5" TextWrapping="Wrap" Margin="0,3,0,0"
                             Foreground="{StaticResource TextMutedBrush}"/>
                </StackPanel>
              </Border>

              <Border Style="{StaticResource Card}">
                <StackPanel>
                  <TextBlock Text="关于" FontSize="14" FontWeight="SemiBold"
                             Foreground="{StaticResource TextBrush}" Margin="0,0,0,10"/>
                  <Grid>
                    <Grid.ColumnDefinitions>
                      <ColumnDefinition Width="118"/>
                      <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    <TextBlock Grid.Column="0" Text="启动器" FontSize="13"
                               Foreground="{StaticResource TextSoftBrush}" VerticalAlignment="Center"/>
                    <TextBlock Grid.Column="1" Text="PclLike —— 自写的 Minecraft 启动器" FontSize="12.5"
                               Foreground="{StaticResource TextBrush}"/>
                  </Grid>
                  <Grid Margin="0,10,0,0">
                    <Grid.ColumnDefinitions>
                      <ColumnDefinition Width="118"/>
                      <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    <TextBlock Grid.Column="0" Text="游戏目录" FontSize="13"
                               Foreground="{StaticResource TextSoftBrush}" VerticalAlignment="Center"/>
                    <TextBlock Grid.Column="1" Text="{Binding GameRoot}" FontSize="12"
                               Foreground="{StaticResource TextMutedBrush}" TextWrapping="Wrap"/>
                  </Grid>
                  <StackPanel Orientation="Horizontal" Margin="0,14,0,0">
                    <Button Content="查看日志" Style="{StaticResource FlatButton}"
                            Click="ShowLog_Click" Margin="0,0,8,0"/>
                    <Button Content="打开目录" Style="{StaticResource FlatButton}"
                            Click="OpenFolder_Click" Margin="0,0,8,0"/>
                    <Button Content="复制路径" Style="{StaticResource FlatButton}"
                            Click="CopyRoot_Click"/>
                  </StackPanel>
                </StackPanel>
              </Border>
            </StackPanel><!-- /ToolSecHelp -->
          </Grid>
        </ScrollViewer>

      </Grid>
    </Grid>

    </Grid>
</Window>
