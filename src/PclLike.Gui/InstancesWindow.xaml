<Window x:Class="PclLike.Gui.InstancesWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="实例管理" Height="600" Width="960"
        Background="{DynamicResource BgBrush}"
        Foreground="{DynamicResource TextBrush}"
        FontFamily="{StaticResource UiFont}" FontSize="13"
        WindowStartupLocation="CenterOwner">

    <Grid Margin="16">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- 标题 -->
        <Grid Grid.Row="0" Margin="0,0,0,12">
            <TextBlock x:Name="TitleText" Text="实例管理" FontSize="18" FontWeight="Bold"
                       VerticalAlignment="Center"/>
            <TextBlock x:Name="CurrentLabel" HorizontalAlignment="Right" VerticalAlignment="Center"
                       FontSize="12" Foreground="{DynamicResource TextMutedBrush}"/>
        </Grid>

        <!-- 左：列表   右：详情 -->
        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="14"/>
                <ColumnDefinition Width="350"/>
            </Grid.ColumnDefinitions>

            <Border Grid.Column="0" Style="{StaticResource Card}" Padding="8">
                <ListBox x:Name="List" Style="{StaticResource VersionList}"
                         SelectionChanged="List_SelectionChanged"
                         MouseDoubleClick="List_MouseDoubleClick"
                         ScrollViewer.HorizontalScrollBarVisibility="Disabled">
                    <ListBox.ItemTemplate>
                        <DataTemplate>
                            <StackPanel Margin="4,6">
                                <TextBlock Text="{Binding Name}" FontSize="14" FontWeight="SemiBold"
                                           TextTrimming="CharacterEllipsis"/>
                                <TextBlock FontSize="11" Foreground="{DynamicResource TextMutedBrush}"
                                           TextTrimming="CharacterEllipsis">
                                    <Run Text="{Binding VersionId, Mode=OneWay}"/>
                                    <Run Text=" · "/>
                                    <Run Text="{Binding IsolationLabel, Mode=OneWay}"/>
                                    <Run Text=" · "/>
                                    <Run Text="{Binding Loader, Mode=OneWay}"/>
                                </TextBlock>
                            </StackPanel>
                        </DataTemplate>
                    </ListBox.ItemTemplate>
                </ListBox>
            </Border>

            <Border Grid.Column="2" Style="{StaticResource Card}" Padding="16">
                <StackPanel x:Name="DetailPanel">
                    <TextBlock Text="实例详情" FontSize="15" FontWeight="Bold" Margin="0,0,0,14"/>

                    <TextBlock Text="名称" FontSize="12" Foreground="{DynamicResource TextMutedBrush}"/>
                    <Grid Margin="0,4,0,4">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <TextBox x:Name="NameBox" Height="30" Padding="8,4"
                                 VerticalContentAlignment="Center"/>
                        <Button Grid.Column="1" Content="保存" Style="{StaticResource FlatButton}"
                                Height="30" Margin="8,0,0,0" Click="Save_Click"/>
                    </Grid>
                    <TextBlock Text="改名只影响显示，实例目录不变。" FontSize="11"
                               Foreground="{DynamicResource TextMutedBrush}" Margin="0,0,0,10"/>

                    <TextBlock x:Name="VerLabel" FontSize="12" Margin="0,3"/>
                    <TextBlock x:Name="IsoLabel" FontSize="12" Margin="0,3"/>
                    <TextBlock x:Name="LoaderLabel" FontSize="12" Margin="0,3"/>
                    <TextBlock x:Name="CreatedLabel" FontSize="12" Margin="0,3"/>
                    <TextBlock x:Name="PlayedLabel" FontSize="12" Margin="0,3"/>
                    <TextBlock x:Name="SizeLabel" FontSize="12" Margin="0,3"/>

                    <TextBlock Text="游戏目录（--gameDir）" FontSize="12"
                               Foreground="{DynamicResource TextMutedBrush}" Margin="0,12,0,4"/>
                    <TextBox x:Name="PathBox" IsReadOnly="True" FontFamily="{StaticResource MonoFont}"
                             FontSize="11" Height="54" Padding="6,4" TextWrapping="Wrap"
                             VerticalScrollBarVisibility="Auto"/>

                    <TextBlock Text="备注" FontSize="12" Foreground="{DynamicResource TextMutedBrush}"
                               Margin="0,12,0,4"/>
                    <TextBox x:Name="NoteBox" FontSize="12" Height="50" Padding="6,4"
                             AcceptsReturn="True" TextWrapping="Wrap"
                             VerticalScrollBarVisibility="Auto"/>
                </StackPanel>
            </Border>
        </Grid>

        <!-- 底部：新建 + 操作 -->
        <Grid Grid.Row="2" Margin="0,14,0,0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>

            <StackPanel Grid.Column="0" Orientation="Horizontal">
                <TextBox x:Name="NewNameBox" Width="168" Height="32" Padding="8,4"
                         VerticalContentAlignment="Center"
                         ToolTip="新实例的名字，中文可以"/>
                <ComboBox x:Name="NewVersionBox" Width="152" Height="32" Margin="8,0,0,0"
                          VerticalContentAlignment="Center"
                          ToolTip="这个实例挂在哪个游戏版本上"/>
                <CheckBox x:Name="NewIsolated" Content="独立游戏目录" Height="32" Margin="12,0,0,0"
                          VerticalContentAlignment="Center" IsChecked="True"
                          ToolTip="勾选：存档/Mod/设置都放在实例目录里，和别的版本互不干扰&#x0a;不勾选：跟启动器根目录共用（和原版行为一致）"/>
                <!-- 这里必须覆盖 Padding：PrimaryButton 默认 18,10，配 Height=32
                     只剩 12px 放 14px 的字，中文会被压成一团。
                     18,6 → 内容区 20px，够 14px 字。 -->
                <Button Content="新建实例" Style="{StaticResource PrimaryButton}"
                        Padding="18,6" Height="32"
                        Margin="12,0,0,0" Click="Create_Click"/>
            </StackPanel>

            <StackPanel Grid.Column="1" Orientation="Horizontal">
                <Button Content="设为当前" Style="{StaticResource FlatButton}" Height="32" Click="Use_Click"/>
                <Button Content="复制" Style="{StaticResource FlatButton}" Height="32"
                        Margin="8,0,0,0" Click="Copy_Click"/>
                <Button Content="打开目录" Style="{StaticResource FlatButton}" Height="32"
                        Margin="8,0,0,0" Click="Open_Click"/>
                <Button Content="删除" Style="{StaticResource FlatButton}" Height="32"
                        Margin="8,0,0,0" Click="Delete_Click"/>
                <Button Content="关闭" Style="{StaticResource FlatButton}" Height="32"
                        Margin="8,0,0,0" Click="Close_Click"/>
            </StackPanel>
        </Grid>
    </Grid>
</Window>