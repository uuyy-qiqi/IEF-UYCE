<Window x:Class="PclLike.Gui.InstancesWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:local="clr-namespace:PclLike.Gui"
        Title="实例管理" Height="660" Width="1040"
        MinHeight="520" MinWidth="860"
        Icon="Assets/pclike.png"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="{DynamicResource BgBrush}"
        Foreground="{DynamicResource TextBrush}"
        FontFamily="{StaticResource UiFont}" FontSize="13"
        WindowStartupLocation="CenterOwner"
        UseLayoutRounding="True" SnapsToDevicePixels="True"
        TextOptions.TextFormattingMode="Display">

  <WindowChrome.WindowChrome>
    <!-- 跟主窗口一样：去掉原生标题栏，顶栏自己画（那对最小化/关闭按钮就是照
         无边框画的，留着原生那条会重复两套按钮）。
         CaptionHeight=0 表示整窗都是客户区，拖动由顶栏处理。 -->
    <WindowChrome CaptionHeight="0" ResizeBorderThickness="6"
                  GlassFrameThickness="1" CornerRadius="0"
                  UseAeroCaptionButtons="False"/>
  </WindowChrome.WindowChrome>

  <Window.Resources>

    <!-- ════════ 左栏：以分组形式呈现的实例列表 ════════ -->

    <!-- 组标题：一整个可点的横条，右边一个小箭头表示展开/折叠 -->
    <Style x:Key="GroupToggle" TargetType="ToggleButton">
      <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
      <Setter Property="Cursor" Value="Hand"/>
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="ToggleButton">
            <Border x:Name="Bd" Background="Transparent" CornerRadius="4" Padding="9,7">
              <ContentPresenter/>
            </Border>
            <ControlTemplate.Triggers>
              <Trigger Property="IsMouseOver" Value="True">
                <Setter TargetName="Bd" Property="Background" Value="{StaticResource HoverBrush}"/>
              </Trigger>
            </ControlTemplate.Triggers>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>

    <!-- 列表本体。不用 VersionList 那个样式：它是给下载页的版本列表配的，
         里面为了给徽章让位留了右padding，这里不需要。 -->
    <Style x:Key="RailList" TargetType="ListBox">
      <Setter Property="Background" Value="Transparent"/>
      <Setter Property="BorderThickness" Value="0"/>
      <Setter Property="Padding" Value="0"/>
      <Setter Property="ScrollViewer.HorizontalScrollBarVisibility" Value="Disabled"/>
      <!-- 外层已经有一个 ScrollViewer 了（两组共用一个滚动条），
           这里再开一个就会出现两个滚动条互相打架。 -->
      <Setter Property="ScrollViewer.VerticalScrollBarVisibility" Value="Disabled"/>
    </Style>

    <!-- 一行实例。选中的标记是左边那根蓝条 —— 跟 PCL 一样，
         而且比只换背景色更容易一眼看出选的是哪个。 -->
    <Style x:Key="InstanceItem" TargetType="ListBoxItem">
      <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
      <Setter Property="Padding" Value="0"/>
      <Setter Property="Margin" Value="0,1"/>
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="ListBoxItem">
            <Grid>
              <Grid.ColumnDefinitions>
                <ColumnDefinition Width="3"/>
                <ColumnDefinition Width="*"/>
              </Grid.ColumnDefinitions>

              <Border x:Name="Bar" Grid.Column="0" Background="Transparent"
                      CornerRadius="2" Margin="0,4"/>

              <Border x:Name="Bd" Grid.Column="1" Background="Transparent"
                      CornerRadius="4" Padding="9,7">
                <ContentPresenter/>
              </Border>
            </Grid>
            <ControlTemplate.Triggers>
              <Trigger Property="IsMouseOver" Value="True">
                <Setter TargetName="Bd" Property="Background" Value="{StaticResource HoverBrush}"/>
              </Trigger>
              <Trigger Property="IsSelected" Value="True">
                <Setter TargetName="Bd" Property="Background" Value="{StaticResource SelectedBrush}"/>
                <Setter TargetName="Bar" Property="Background" Value="{StaticResource PrimaryBrush}"/>
              </Trigger>
            </ControlTemplate.Triggers>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>

    <!-- 小芯片：版本号 / 加载器。PCL 也是这么把这两个信息并排放在名字下面的。 -->
    <Style x:Key="Chip" TargetType="Border">
      <Setter Property="Background" Value="#8CFFFFFF"/>
      <Setter Property="BorderBrush" Value="{StaticResource BorderBrush2}"/>
      <Setter Property="BorderThickness" Value="1"/>
      <Setter Property="CornerRadius" Value="3"/>
      <!-- 上下都要留 2：中文的字身比英文高，只留 1 会把下缘切掉一点。
           这里不写死高度，让内容自己撑。 -->
      <Setter Property="Padding" Value="6,1,6,2"/>
      <Setter Property="VerticalAlignment" Value="Center"/>
      <Setter Property="TextBlock.FontSize" Value="10.5"/>
      <Setter Property="TextBlock.Foreground" Value="{StaticResource TextSoftBrush}"/>
    </Style>

    <!-- ════════ 顶栏按钮 ════════ -->

    <Style x:Key="BarButton" TargetType="Button">
      <Setter Property="Width" Value="34"/>
      <Setter Property="Height" Value="34"/>
      <Setter Property="Cursor" Value="Hand"/>
      <Setter Property="Background" Value="Transparent"/>
      <Setter Property="BorderThickness" Value="0"/>
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="Button">
            <Border x:Name="Bd" Background="Transparent" CornerRadius="4">
              <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
            </Border>
            <ControlTemplate.Triggers>
              <Trigger Property="IsMouseOver" Value="True">
                <Setter TargetName="Bd" Property="Background" Value="#30FFFFFF"/>
              </Trigger>
            </ControlTemplate.Triggers>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>

    <Style x:Key="BarCloseButton" TargetType="Button" BasedOn="{StaticResource BarButton}">
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="Button">
            <Border x:Name="Bd" Background="Transparent" CornerRadius="4">
              <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
            </Border>
            <ControlTemplate.Triggers>
              <Trigger Property="IsMouseOver" Value="True">
                <Setter TargetName="Bd" Property="Background" Value="#C42B1C"/>
              </Trigger>
            </ControlTemplate.Triggers>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>

    <Style x:Key="BarGlyph" TargetType="TextBlock">
      <Setter Property="FontFamily" Value="Segoe MDL2 Assets"/>
      <Setter Property="FontSize" Value="11"/>
      <Setter Property="Foreground" Value="White"/>
    </Style>

    <!-- ════════ 右侧详情 ════════ -->

    <Style x:Key="FieldLabel" TargetType="TextBlock">
      <Setter Property="FontSize" Value="12"/>
      <Setter Property="Foreground" Value="{StaticResource TextMutedBrush}"/>
      <Setter Property="Margin" Value="0,0,10,0"/>
      <Setter Property="VerticalAlignment" Value="Center"/>
    </Style>

    <Style x:Key="FieldValue" TargetType="TextBlock">
      <Setter Property="FontSize" Value="12.5"/>
      <Setter Property="TextTrimming" Value="CharacterEllipsis"/>
      <Setter Property="VerticalAlignment" Value="Center"/>
    </Style>

  </Window.Resources>

  <Grid>
    <Grid.RowDefinitions>
      <RowDefinition Height="Auto"/>
      <RowDefinition Height="*"/>
      <RowDefinition Height="Auto"/>
    </Grid.RowDefinitions>

    <!-- ════════ 顶栏 ════════ -->
    <Border Grid.Row="0" Height="46" Background="{StaticResource TopBarBrush}"
            MouseLeftButtonDown="TopBar_MouseDown">
      <Grid Margin="4,0">
        <Grid.ColumnDefinitions>
          <ColumnDefinition Width="Auto"/>
          <ColumnDefinition Width="Auto"/>
          <ColumnDefinition Width="*"/>
          <ColumnDefinition Width="Auto"/>
          <ColumnDefinition Width="Auto"/>
        </Grid.ColumnDefinitions>

        <Button Grid.Column="0" Style="{StaticResource BarButton}" Click="Close_Click"
                ToolTip="关闭">
          <TextBlock Text="&#xE72B;" Style="{StaticResource BarGlyph}" FontSize="13"/>
        </Button>

        <TextBlock Grid.Column="1" Text="实例管理" Foreground="White" FontSize="14.5"
                   FontWeight="SemiBold" VerticalAlignment="Center" Margin="4,0,0,0"/>

        <TextBlock Grid.Column="2" x:Name="CurrentLabel" HorizontalAlignment="Right"
                   VerticalAlignment="Center" Foreground="#D9FFFFFF" FontSize="12"
                   Margin="0,0,12,0"/>

        <Button Grid.Column="3" Style="{StaticResource BarButton}" Click="Minimize_Click"
                ToolTip="最小化">
          <TextBlock Text="&#xE921;" Style="{StaticResource BarGlyph}"/>
        </Button>

        <Button Grid.Column="4" Style="{StaticResource BarCloseButton}" Click="Close_Click"
                ToolTip="关闭">
          <TextBlock Text="&#xE8BB;" Style="{StaticResource BarGlyph}"/>
        </Button>
      </Grid>
    </Border>

    <!-- ════════ 左栏 + 详情 ════════ -->
    <Grid Grid.Row="1">
      <Grid.ColumnDefinitions>
        <ColumnDefinition Width="320"/>
        <ColumnDefinition Width="*"/>
      </Grid.ColumnDefinitions>

      <Border Grid.Column="0" Background="{StaticResource RailBrush}"
              BorderBrush="{StaticResource BorderBrush2}" BorderThickness="0,0,1,0">
        <Grid>
          <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
          </Grid.RowDefinitions>

          <TextBlock Grid.Row="0" Text="实例列表" FontSize="13" FontWeight="SemiBold"
                     Foreground="{StaticResource TextSoftBrush}" Margin="14,13,14,0"/>

          <!-- 搜索 -->
          <Border Grid.Row="1" Height="34" Margin="12,10,12,8" CornerRadius="4"
                  Background="#8CFFFFFF" BorderBrush="{StaticResource BorderBrush2}"
                  BorderThickness="1">
            <Grid>
              <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="*"/>
              </Grid.ColumnDefinitions>

              <TextBlock Grid.Column="0" Text="&#xE721;" FontFamily="Segoe MDL2 Assets"
                         FontSize="13" Foreground="{StaticResource TextMutedBrush}"
                         Margin="10,0,6,0" VerticalAlignment="Center"/>

              <TextBox Grid.Column="1" BorderThickness="0" Background="Transparent"
                       VerticalContentAlignment="Center" FontSize="12.5"
                       Text="{Binding Filter, UpdateSourceTrigger=PropertyChanged}"
                       ToolTip="按名字、版本、加载器或路径过滤"/>
            </Grid>
          </Border>

          <ScrollViewer Grid.Row="2" VerticalScrollBarVisibility="Auto" Padding="8,0,4,0">
            <StackPanel>
              <ItemsControl ItemsSource="{Binding Groups}">
                <ItemsControl.ItemTemplate>
                  <DataTemplate>
                    <StackPanel Visibility="{Binding GroupVisibility}">

                      <ToggleButton Style="{StaticResource GroupToggle}"
                                    IsChecked="{Binding IsExpanded, Mode=TwoWay}">
                        <Grid>
                          <TextBlock Text="{Binding HeaderText}" FontSize="12"
                                     FontWeight="SemiBold" VerticalAlignment="Center"
                                     Foreground="{StaticResource TextSoftBrush}"/>
                          <TextBlock Text="{Binding Chevron}" FontFamily="Segoe MDL2 Assets"
                                     FontSize="10" HorizontalAlignment="Right"
                                     VerticalAlignment="Center"
                                     Foreground="{StaticResource TextMutedBrush}"/>
                        </Grid>
                      </ToggleButton>

                      <ListBox ItemsSource="{Binding Rows}"
                               SelectedItem="{Binding Selected, Mode=TwoWay}"
                               Style="{StaticResource RailList}"
                               ItemContainerStyle="{StaticResource InstanceItem}"
                               Visibility="{Binding RowsVisibility}"
                               SelectionChanged="Group_SelectionChanged"
                               MouseDoubleClick="Group_MouseDoubleClick"
                               Margin="2,0,0,6">
                        <ListBox.ItemTemplate>
                          <DataTemplate DataType="{x:Type local:InstanceRow}">
                            <Grid>
                              <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="*"/>
                              </Grid.ColumnDefinitions>

                              <local:BlockGlyph Width="28" Height="28" VerticalAlignment="Center"
                                                TopBrush="{Binding Top}"
                                                LeftBrush="{Binding Left}"
                                                RightBrush="{Binding Right}"/>

                              <StackPanel Grid.Column="1" Margin="10,0,0,0"
                                          VerticalAlignment="Center">
                                <TextBlock Text="{Binding Name}" FontSize="13.5"
                                           FontWeight="SemiBold"
                                           TextTrimming="CharacterEllipsis"/>
                                <StackPanel Orientation="Horizontal" Margin="0,5,0,0">
                                  <Border Style="{StaticResource Chip}">
                                    <TextBlock Text="{Binding McVersion}"/>
                                  </Border>
                                  <Border Style="{StaticResource Chip}" Margin="5,0,0,0">
                                    <TextBlock Text="{Binding LoaderText}"/>
                                  </Border>
                                  <!-- 两个实例重名时才出现：实例目录名，用来区分 -->
                                  <Border Style="{StaticResource Chip}" Margin="5,0,0,0"
                                          Visibility="{Binding DuplicateVisibility}">
                                    <Border.ToolTip>
                                      <ToolTip Content="有两个实例重名，这里显示的是实例目录名"/>
                                    </Border.ToolTip>
                                    <TextBlock Text="{Binding DuplicateId}"/>
                                  </Border>
                                </StackPanel>
                              </StackPanel>
                            </Grid>
                          </DataTemplate>
                        </ListBox.ItemTemplate>
                      </ListBox>

                    </StackPanel>
                  </DataTemplate>
                </ItemsControl.ItemTemplate>
              </ItemsControl>

              <TextBlock Text="{Binding EmptyText}" Visibility="{Binding EmptyVisibility}"
                         FontSize="12" Foreground="{StaticResource TextMutedBrush}"
                         Margin="10,16,10,0" TextWrapping="Wrap"/>
            </StackPanel>
          </ScrollViewer>

          <TextBlock Grid.Row="3" Text="双击实例 = 设为当前，之后点启动就走它"
                     FontSize="11" Foreground="{StaticResource TextMutedBrush}"
                     Margin="14,8,14,13" TextWrapping="Wrap"/>
        </Grid>
      </Border>

      <!-- 详情 -->
      <Border Grid.Column="1" Style="{StaticResource Card}" Margin="16">
        <StackPanel x:Name="DetailPanel">

          <Grid Margin="0,0,0,16">
            <Grid.ColumnDefinitions>
              <ColumnDefinition Width="Auto"/>
              <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <local:BlockGlyph x:Name="DetailGlyph" Width="36" Height="36"
                              VerticalAlignment="Center"/>

            <StackPanel Grid.Column="1" Margin="13,0,0,0" VerticalAlignment="Center">
              <TextBlock x:Name="DetailName" FontSize="16" FontWeight="Bold"
                         TextTrimming="CharacterEllipsis"/>
              <StackPanel Orientation="Horizontal" Margin="0,6,0,0">
                <Border Style="{StaticResource Chip}">
                  <TextBlock x:Name="DetailMc"/>
                </Border>
                <Border Style="{StaticResource Chip}" Margin="6,0,0,0">
                  <TextBlock x:Name="DetailLoader"/>
                </Border>
                <Border Style="{StaticResource Chip}" Margin="6,0,0,0">
                  <TextBlock x:Name="DetailIsoChip"/>
                </Border>
              </StackPanel>
            </StackPanel>
          </Grid>

          <TextBlock Text="名称" Style="{StaticResource FieldLabel}" Margin="0,0,0,4"/>
          <Grid Margin="0,0,0,4">
            <Grid.ColumnDefinitions>
              <ColumnDefinition Width="*"/>
              <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>
            <TextBox x:Name="NameBox" Height="32" Padding="8,4"
                     VerticalContentAlignment="Center"/>
            <Button Grid.Column="1" Content="保存" Style="{StaticResource FlatButton}"
                    Padding="14,6" Height="32" Margin="8,0,0,0" Click="Save_Click"/>
          </Grid>
          <TextBlock Text="改名只影响显示，实例目录不变。" FontSize="11"
                     Foreground="{StaticResource TextMutedBrush}" Margin="0,0,0,14"/>

          <Grid>
            <Grid.ColumnDefinitions>
              <ColumnDefinition Width="76"/>
              <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>
            <Grid.RowDefinitions>
              <RowDefinition Height="Auto"/>
              <RowDefinition Height="Auto"/>
              <RowDefinition Height="Auto"/>
              <RowDefinition Height="Auto"/>
              <RowDefinition Height="Auto"/>
              <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <TextBlock Grid.Row="0" Text="游戏版本" Style="{StaticResource FieldLabel}"/>
            <TextBlock Grid.Row="0" Grid.Column="1" x:Name="VerLabel"
                       Style="{StaticResource FieldValue}"/>

            <TextBlock Grid.Row="1" Text="游戏目录" Style="{StaticResource FieldLabel}" Margin="0,7,10,0"/>
            <TextBlock Grid.Row="1" Grid.Column="1" x:Name="IsoLabel"
                       Style="{StaticResource FieldValue}" Margin="0,7,0,0"/>

            <TextBlock Grid.Row="2" Text="加载器" Style="{StaticResource FieldLabel}" Margin="0,7,10,0"/>
            <TextBlock Grid.Row="2" Grid.Column="1" x:Name="LoaderLabel"
                       Style="{StaticResource FieldValue}" Margin="0,7,0,0"/>

            <TextBlock Grid.Row="3" Text="创建时间" Style="{StaticResource FieldLabel}" Margin="0,7,10,0"/>
            <TextBlock Grid.Row="3" Grid.Column="1" x:Name="CreatedLabel"
                       Style="{StaticResource FieldValue}" Margin="0,7,0,0"/>

            <TextBlock Grid.Row="4" Text="最近游玩" Style="{StaticResource FieldLabel}" Margin="0,7,10,0"/>
            <TextBlock Grid.Row="4" Grid.Column="1" x:Name="PlayedLabel"
                       Style="{StaticResource FieldValue}" Margin="0,7,0,0"/>

            <TextBlock Grid.Row="5" Text="占用空间" Style="{StaticResource FieldLabel}" Margin="0,7,10,0"/>
            <TextBlock Grid.Row="5" Grid.Column="1" x:Name="SizeLabel"
                       Style="{StaticResource FieldValue}" Margin="0,7,0,0"/>
          </Grid>

          <TextBlock Text="游戏目录（--gameDir）" Style="{StaticResource FieldLabel}"
                     Margin="0,16,0,5"/>
          <TextBox x:Name="PathBox" IsReadOnly="True" FontFamily="{StaticResource MonoFont}"
                   FontSize="11" Height="52" Padding="6,4" TextWrapping="Wrap"
                   VerticalScrollBarVisibility="Auto"/>

          <TextBlock Text="备注" Style="{StaticResource FieldLabel}" Margin="0,14,0,5"/>
          <TextBox x:Name="NoteBox" FontSize="12" Height="56" Padding="6,4"
                   AcceptsReturn="True" TextWrapping="Wrap"
                   VerticalScrollBarVisibility="Auto"/>
        </StackPanel>
      </Border>
    </Grid>

    <!-- ════════ 底栏：新建 + 操作 ════════ -->
    <Border Grid.Row="2" Background="#33FFFFFF" BorderBrush="{StaticResource BorderBrush2}"
            BorderThickness="0,1,0,0" Padding="16,12">
      <Grid>
        <Grid.ColumnDefinitions>
          <ColumnDefinition Width="*"/>
          <ColumnDefinition Width="Auto"/>
        </Grid.ColumnDefinitions>

        <StackPanel Grid.Column="0" Orientation="Horizontal">
          <TextBox x:Name="NewNameBox" Width="160" Height="32" Padding="8,4"
                   VerticalContentAlignment="Center"
                   ToolTip="新实例的名字，中文可以"/>
          <ComboBox x:Name="NewVersionBox" Width="148" Height="32" Margin="8,0,0,0"
                    VerticalContentAlignment="Center"
                    ToolTip="这个实例挂在哪个游戏版本上"/>
          <CheckBox x:Name="NewIsolated" Content="独立游戏目录" Height="32" Margin="12,0,0,0"
                    VerticalContentAlignment="Center" IsChecked="True"
                    ToolTip="勾选：存档/Mod/设置都放在实例目录里，和别的版本互不干扰&#x0a;不勾选：跟启动器根目录共用（和原版行为一致）"/>
          <!-- 这里必须覆盖 Padding：PrimaryButton 默认 18,10，配 Height=32
               只剩 12px 放 14px 的字，中文会被压成一团。
               18,6 → 内容区 20px，够 14px 字。 -->
          <Button Content="新建实例" Style="{StaticResource PrimaryButton}"
                  Padding="18,6" Height="32" Margin="12,0,0,0" Click="Create_Click"/>
        </StackPanel>

        <StackPanel Grid.Column="1" Orientation="Horizontal">
          <Button Content="设为当前" Style="{StaticResource FlatButton}" Padding="14,6"
                  Height="32" Click="Use_Click"/>
          <Button Content="复制" Style="{StaticResource FlatButton}" Padding="14,6"
                  Height="32" Margin="8,0,0,0" Click="Copy_Click"/>
          <Button Content="打开目录" Style="{StaticResource FlatButton}" Padding="14,6"
                  Height="32" Margin="8,0,0,0" Click="Open_Click"/>
          <Button Content="删除" Style="{StaticResource FlatButton}" Padding="14,6"
                  Height="32" Margin="8,0,0,0" Click="Delete_Click"/>
          <Button Content="关闭" Style="{StaticResource FlatButton}" Padding="14,6"
                  Height="32" Margin="8,0,0,0" Click="Close_Click"/>
        </StackPanel>
      </Grid>
    </Border>
  </Grid>
</Window>